---
import RelocateCta from './RelocateCta.astro';
---
<footer class="bg-dark-sage text-white/70 mt-20">
  <div class="max-w-6xl mx-auto px-6 py-16">
    <div class="grid md:grid-cols-4 gap-10">
      <div>
          <a href="https://bellieacreswine.com/" class="flex items-center gap-3 mb-4 text-white hover:text-white">
            <div class="w-8 h-8 bg-white/10 rounded-2xl flex items-center justify-center">
              <span class="text-lg">🍷</span>
            </div>
            <span class="font-serif text-2xl text-white tracking-tight">Bellie Acres Wine</span>
          </a>
        <p class="text-sm">
          Independent Temecula wine-country publisher at
          <a class="text-white underline hover:text-white" href="https://bellieacreswine.com/">https://bellieacreswine.com</a>
          — guides, harvest coverage, tasting routes, plus a practical list and map.
        </p>
        <RelocateCta variant="footer" />
      </div>

      <div>
        <div class="font-medium text-white mb-4">Explore</div>
        <div class="space-y-2 text-sm">
          <a href="/search" class="block hover:text-white">Search</a>
          <a href="/wineries" class="block hover:text-white">Temecula Wineries List</a>
          <a href="/pairings" class="block hover:text-white">Wine Pairings</a>
          <a href="/map" class="block hover:text-white">Temecula Wine Map</a>
          <a href="/collection" class="block hover:text-white">The Wine Collection</a>
          <a href="/guides" class="block hover:text-white">Guides</a>
          <a href="/events" class="block hover:text-white">Events</a>
          <a href="/balloons" class="block hover:text-white">Balloon Rides</a>
        </div>
      </div>

      <div>
        <div class="font-medium text-white mb-4">Discover</div>
        <div class="space-y-2 text-sm">
          <a href="/guides/good-wine-no-whine" class="block hover:text-white">Fun Puns</a>
          <a href="/guides/temecula-harvest-season" class="block hover:text-white">Harvest Season Guide</a>
          <a href="/wine-day-planner/" class="block hover:text-white">Wine Day Planner (Free PDF)</a>
          <a href="/guides/best-temecula-wineries" class="block hover:text-white">Best Temecula Wineries</a>
          <a href="/guides/weekend-in-temecula-wine-country" class="block hover:text-white">Weekend Wine Country</a>
          <a href="/guides/temecula-red-varietals" class="block hover:text-white">Temecula Red Varietals</a>
          <a href="/guides/weekday-vs-weekend-tasting" class="block hover:text-white">Weekday vs Weekend</a>
          <a href="/pairings" class="block hover:text-white">Wine Pairing Ideas</a>
          <a href="/guides/first-timer-tasting-route" class="block hover:text-white">First-Timer Route</a>
          <a href="/guides/pet-friendly-wineries" class="block hover:text-white">Pet-Friendly Wineries</a>
          <a href="/guides/sip-with-a-view" class="block hover:text-white">Sip with a View</a>
          <a href="/advertise" class="block hover:text-white">Advertise / Featured Listing</a>
          <a href="/about" class="block hover:text-white">About</a>
          <a href="/contact" class="block hover:text-white">Contact</a>
          <a href="/privacy" class="block hover:text-white">Privacy Policy</a>
          <a href="/terms" class="block hover:text-white">Terms of Use</a>
        </div>
      </div>

      <div>
        <div class="font-medium text-white mb-4">Connect</div>
        <div class="space-y-2 text-sm">
          <a href="/contact" class="block hover:text-white">Contact form</a>
          <a href="mailto:executerceo@gmail.com" class="block hover:text-white">executerceo@gmail.com</a>
          <a
            href="https://lauradfarley.com/"
            class="block hover:text-white"
            rel="noopener noreferrer"
            target="_blank"
          >Moving to Temecula? Local REALTOR®</a>
          <a
            href="https://lauradfarley.com/sell/"
            class="block hover:text-white"
            rel="noopener noreferrer"
            target="_blank"
          >Estate owner looking to sell?</a>
          <p class="text-white/50 pt-2">We are an independent guide, not a winery or tasting room.</p>
        </div>
      </div>
    </div>

    <div class="border-t border-white/10 mt-12 pt-8 text-xs flex flex-col md:flex-row justify-between gap-4">
      <div>© {new Date().getFullYear()} Bellie Acres Wine (<a class="text-white/80 underline hover:text-white" href="https://bellieacreswine.com/">bellieacreswine.com</a>). All rights reserved.</div>
      <div>Please drink responsibly. 21+ for alcohol tastings.</div>
    </div>
  </div>
</footer>
