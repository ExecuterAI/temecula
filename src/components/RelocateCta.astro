---
/**
 * Soft cross-promo: wine-directory visitors who may relocate to Temecula.
 * Links to Laura's RE site — editorial, not aggressive.
 */
interface Props {
  /** footer = compact dark-friendly; card = light page section */
  variant?: 'footer' | 'card' | 'banner';
  class?: string;
}

const { variant = 'card', class: className = '' } = Astro.props;
const href = 'https://lauradfarley.com/';
---

{variant === 'footer' && (
  <div class:list={['pt-4 mt-4 border-t border-white/10', className]}>
    <div class="font-medium text-white mb-2 text-sm">Moving to Temecula?</div>
    <p class="text-sm text-white/60 leading-relaxed mb-2">
      Local residential real estate guidance from Laura D. Farley, MBA — listing and buying in Temecula Valley.
    </p>
    <a
      href={href}
      class="inline-block text-sm text-white hover:underline font-medium"
      rel="noopener noreferrer"
      target="_blank"
    >
      Explore living in Temecula →
    </a>
  </div>
)}

{variant === 'banner' && (
  <aside
    class:list={[
      'rounded-3xl border border-[#9AAB97]/40 bg-[#f7f6f2] px-6 py-5 sm:px-8 sm:py-6 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4',
      className,
    ]}
  >
    <div class="max-w-2xl">
      <p class="text-[11px] tracking-[0.18em] uppercase text-[#4A5E4E] font-semibold mb-1">Temecula living</p>
      <p class="font-serif text-2xl sm:text-3xl text-stone-900 leading-snug">
        Thinking about moving to Temecula?
      </p>
      <p class="text-stone-600 mt-2 text-sm sm:text-base leading-relaxed">
        If Wine Country visits have you picturing a longer stay, Laura D. Farley, MBA provides local guidance for
        buyers and sellers across Temecula Valley.
      </p>
    </div>
    <a
      href={href}
      class="shrink-0 inline-flex items-center justify-center px-6 py-3 rounded-full bg-[#4A5E4E] text-white text-sm font-medium hover:opacity-90 transition whitespace-nowrap"
      rel="noopener noreferrer"
      target="_blank"
    >
      Meet your local agent →
    </a>
  </aside>
)}

{variant === 'card' && (
  <section class:list={['max-w-3xl', className]}>
    <div class="rounded-3xl border border-stone-200 bg-white p-8 shadow-sm">
      <p class="text-[11px] tracking-[0.18em] uppercase text-[var(--accent)] font-semibold mb-2">Relocating</p>
      <h2 class="font-serif text-3xl text-stone-900 tracking-tight">Thinking about moving to Temecula?</h2>
      <p class="text-stone-600 mt-4 leading-relaxed">
        Many visitors fall for the valley on a tasting day. If you are exploring a move — buying or selling —
        <strong> Laura D. Farley, MBA</strong> offers local residential real estate guidance in Temecula Valley,
        with service also available in Orange County and Hacienda Heights.
      </p>
      <a
        href={href}
        class="inline-flex mt-6 items-center justify-center px-6 py-3 rounded-full bg-[var(--primary)] text-white text-sm font-medium hover:opacity-90 transition"
        rel="noopener noreferrer"
        target="_blank"
      >
        Visit lauradfarley.com →
      </a>
    </div>
  </section>
)}
