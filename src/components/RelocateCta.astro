---
/**
 * Soft cross-promo: wine-directory visitors who may relocate or sell in Temecula.
 * Links to Laura's RE site — editorial, not aggressive.
 * Equal welcome for buyers and sellers.
 */
interface Props {
  /** footer = compact dark-friendly; card = light page section; banner = homepage strip */
  variant?: 'footer' | 'card' | 'banner';
  class?: string;
}

const { variant = 'card', class: className = '' } = Astro.props;
const hrefHome = 'https://lauradfarley.com/';
const hrefSell = 'https://lauradfarley.com/sell/';
const livingBg = '/images/temecula-living-estate.jpg';
---

{variant === 'footer' && (
  <div class:list={['pt-4 mt-4 border-t border-white/10 space-y-4', className]}>
    <div>
      <div class="font-medium text-white mb-2 text-sm">Moving to Temecula?</div>
      <p class="text-sm text-white/60 leading-relaxed mb-2">
        Local residential real estate guidance from Laura D. Farley, MBA — buying and listing in Temecula Valley.
      </p>
      <a
        href={hrefHome}
        class="inline-block text-sm text-white hover:underline font-medium"
        rel="noopener noreferrer"
        target="_blank"
      >
        Explore living in Temecula →
      </a>
    </div>
    <div>
      <div class="font-medium text-white mb-2 text-sm">Estate owner looking to sell?</div>
      <p class="text-sm text-white/60 leading-relaxed mb-2">
        Strategic listing guidance for homes and estate properties in Wine Country.
      </p>
      <a
        href={hrefSell}
        class="inline-block text-sm text-white hover:underline font-medium"
        rel="noopener noreferrer"
        target="_blank"
      >
        Sell with a local agent →
      </a>
    </div>
  </div>
)}

{variant === 'banner' && (
  <aside
    class:list={[
      'relative overflow-hidden rounded-3xl border border-[#9AAB97]/50 shadow-[0_18px_50px_-28px_rgba(43,50,44,0.45)]',
      className,
    ]}
  >
    {/* Dream-home background — faded, right-weighted so text stays readable */}
    <div class="absolute inset-0" aria-hidden="true">
      <img
        src={livingBg}
        alt=""
        class="h-full w-full object-cover object-[72%_45%] scale-105"
        loading="lazy"
        decoding="async"
      />
      {/* Soft wash: ivory left for copy, gentle photo reveal on the right */}
      <div
        class="absolute inset-0"
        style="background:
          linear-gradient(105deg,
            rgba(247,246,242,0.97) 0%,
            rgba(247,246,242,0.94) 38%,
            rgba(247,246,242,0.72) 58%,
            rgba(74,94,78,0.28) 100%),
          linear-gradient(to top, rgba(247,246,242,0.55) 0%, transparent 42%);"
      ></div>
      {/* Subtle sage edge glow */}
      <div class="absolute inset-0 ring-1 ring-inset ring-white/40 rounded-3xl pointer-events-none"></div>
    </div>

    <div class="relative z-10 px-6 py-7 sm:px-9 sm:py-9">
      <div class="flex flex-col lg:flex-row lg:items-start lg:justify-between gap-6">
        <div class="max-w-xl">
          <p
            class="inline-flex items-center gap-2 text-[11px] tracking-[0.18em] uppercase text-[#4A5E4E] font-semibold mb-2"
          >
            <span class="inline-block h-1.5 w-1.5 rounded-full bg-[#9AAB97]"></span>
            Temecula living
          </p>
          <p class="font-serif text-3xl sm:text-[2.15rem] text-stone-900 leading-snug tracking-tight drop-shadow-[0_1px_0_rgba(255,255,255,0.6)]">
            Thinking about moving to Temecula?
          </p>
          <p class="text-stone-700 mt-3 text-sm sm:text-base leading-relaxed max-w-lg">
            If Wine Country visits have you picturing a longer stay, Laura D. Farley, MBA provides local guidance for
            buyers and sellers across Temecula Valley.
          </p>
          <div class="mt-5 flex flex-wrap items-center gap-3">
            <a
              href={hrefHome}
              class="inline-flex items-center justify-center px-6 py-3 rounded-full bg-[#4A5E4E] text-white text-sm font-medium shadow-md shadow-[#4A5E4E]/25 hover:opacity-90 hover:shadow-lg transition"
              rel="noopener noreferrer"
              target="_blank"
            >
              Meet your local agent →
            </a>
            <span class="hidden sm:inline text-xs text-stone-500 tracking-wide">Equal support for buyers and sellers</span>
          </div>
        </div>

        {/* Decorative photo peek on large screens (extra visual punch) */}
        <div
          class="hidden lg:block shrink-0 w-44 xl:w-52 h-36 xl:h-40 rounded-2xl overflow-hidden border border-white/70 shadow-lg shadow-stone-900/15 ring-1 ring-stone-900/5"
          aria-hidden="true"
        >
          <img
            src={livingBg}
            alt=""
            class="h-full w-full object-cover object-center"
            loading="lazy"
            decoding="async"
          />
        </div>
      </div>

      <div
        class="mt-6 pt-5 border-t border-[#4A5E4E]/15 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 backdrop-blur-[2px]"
      >
        <p class="text-stone-800 text-sm sm:text-base leading-relaxed max-w-2xl">
          <span class="font-medium text-stone-900">Or, are you an estate owner looking to sell?</span>
          {' '}
          Strategic listing support for homes and estate properties in the valley.
        </p>
        <a
          href={hrefSell}
          class="shrink-0 inline-flex items-center justify-center px-5 py-2.5 rounded-full border border-[#4A5E4E]/80 text-[#4A5E4E] bg-white/90 backdrop-blur-sm text-sm font-medium hover:bg-[#4A5E4E] hover:text-white hover:border-[#4A5E4E] transition whitespace-nowrap shadow-sm"
          rel="noopener noreferrer"
          target="_blank"
        >
          Sell with strategy →
        </a>
      </div>
    </div>
  </aside>
)}

{variant === 'card' && (
  <section class:list={['max-w-3xl', className]}>
    <div class="rounded-3xl border border-stone-200 bg-white p-8 shadow-sm space-y-8 overflow-hidden relative">
      <div
        class="pointer-events-none absolute -right-8 -top-8 w-40 h-40 rounded-full opacity-[0.12] bg-cover bg-center"
        style={`background-image: url('${livingBg}')`}
        aria-hidden="true"
      ></div>
      <div class="relative">
        <p class="text-[11px] tracking-[0.18em] uppercase text-[var(--accent)] font-semibold mb-2">Relocating</p>
        <h2 class="font-serif text-3xl text-stone-900 tracking-tight">Thinking about moving to Temecula?</h2>
        <p class="text-stone-600 mt-4 leading-relaxed">
          Many visitors fall for the valley on a tasting day. If you are exploring a move,
          <strong> Laura D. Farley, MBA</strong> offers local residential real estate guidance in Temecula Valley,
          with service also available in Orange County and Hacienda Heights.
        </p>
        <a
          href={hrefHome}
          class="inline-flex mt-6 items-center justify-center px-6 py-3 rounded-full bg-[var(--primary)] text-white text-sm font-medium hover:opacity-90 transition"
          rel="noopener noreferrer"
          target="_blank"
        >
          Visit lauradfarley.com →
        </a>
      </div>

      <div class="relative pt-8 border-t border-stone-100">
        <p class="text-[11px] tracking-[0.18em] uppercase text-[var(--accent)] font-semibold mb-2">Selling</p>
        <h2 class="font-serif text-2xl sm:text-3xl text-stone-900 tracking-tight">
          Estate owner looking to sell?
        </h2>
        <p class="text-stone-600 mt-4 leading-relaxed">
          Whether you own a hillside home, a wine-country property, or a family estate ready for the next chapter,
          Laura provides equal, strategic support for sellers — clear process, informed pricing conversations, and
          local market context.
        </p>
        <a
          href={hrefSell}
          class="inline-flex mt-6 items-center justify-center px-6 py-3 rounded-full border border-[var(--primary)] text-[var(--primary)] text-sm font-medium hover:bg-[var(--primary)] hover:text-white transition"
          rel="noopener noreferrer"
          target="_blank"
        >
          Sell with a local agent →
        </a>
      </div>
    </div>
  </section>
)}
