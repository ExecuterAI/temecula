---
/**
 * Soft cross-promo: wine-directory visitors who may relocate or sell in Temecula.
 * Links to Laura's RE site — editorial, not aggressive.
 * Equal welcome for buyers and sellers.
 */
interface Props {
  /** footer = compact dark-friendly; card = light page section; banner = homepage strip */
  variant?: 'footer' | 'card' | 'banner';
  class?: string;
}

const { variant = 'card', class: className = '' } = Astro.props;
const hrefHome = 'https://lauradfarley.com/';
const hrefSell = 'https://lauradfarley.com/sell/';
---

{variant === 'footer' && (
  <div class:list={['pt-4 mt-4 border-t border-white/10 space-y-4', className]}>
    <div>
      <div class="font-medium text-white mb-2 text-sm">Moving to Temecula?</div>
      <p class="text-sm text-white/60 leading-relaxed mb-2">
        Local residential real estate guidance from Laura D. Farley, MBA — buying and listing in Temecula Valley.
      </p>
      <a
        href={hrefHome}
        class="inline-block text-sm text-white hover:underline font-medium"
        rel="noopener noreferrer"
        target="_blank"
      >
        Explore living in Temecula →
      </a>
    </div>
    <div>
      <div class="font-medium text-white mb-2 text-sm">Estate owner looking to sell?</div>
      <p class="text-sm text-white/60 leading-relaxed mb-2">
        Strategic listing guidance for homes and estate properties in Wine Country.
      </p>
      <a
        href={hrefSell}
        class="inline-block text-sm text-white hover:underline font-medium"
        rel="noopener noreferrer"
        target="_blank"
      >
        Sell with a local agent →
      </a>
    </div>
  </div>
)}

{variant === 'banner' && (
  <aside
    class:list={[
      'rounded-3xl border border-[#9AAB97]/40 bg-[#f7f6f2] px-6 py-5 sm:px-8 sm:py-6',
      className,
    ]}
  >
    <div class="flex flex-col lg:flex-row lg:items-start lg:justify-between gap-6">
      <div class="max-w-2xl">
        <p class="text-[11px] tracking-[0.18em] uppercase text-[#4A5E4E] font-semibold mb-1">Temecula living</p>
        <p class="font-serif text-2xl sm:text-3xl text-stone-900 leading-snug">
          Thinking about moving to Temecula?
        </p>
        <p class="text-stone-600 mt-2 text-sm sm:text-base leading-relaxed">
          If Wine Country visits have you picturing a longer stay, Laura D. Farley, MBA provides local guidance for
          buyers and sellers across Temecula Valley.
        </p>
      </div>
      <a
        href={hrefHome}
        class="shrink-0 inline-flex items-center justify-center px-6 py-3 rounded-full bg-[#4A5E4E] text-white text-sm font-medium hover:opacity-90 transition whitespace-nowrap self-start"
        rel="noopener noreferrer"
        target="_blank"
      >
        Meet your local agent →
      </a>
    </div>

    <div class="mt-5 pt-5 border-t border-[#9AAB97]/30 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
      <p class="text-stone-700 text-sm sm:text-base leading-relaxed">
        <span class="font-medium text-stone-900">Or, are you an estate owner looking to sell?</span>
        {' '}
        Strategic listing support for homes and estate properties in the valley.
      </p>
      <a
        href={hrefSell}
        class="shrink-0 inline-flex items-center justify-center px-5 py-2.5 rounded-full border border-[#4A5E4E] text-[#4A5E4E] bg-white text-sm font-medium hover:bg-[#4A5E4E] hover:text-white transition whitespace-nowrap"
        rel="noopener noreferrer"
        target="_blank"
      >
        Sell with strategy →
      </a>
    </div>
  </aside>
)}

{variant === 'card' && (
  <section class:list={['max-w-3xl', className]}>
    <div class="rounded-3xl border border-stone-200 bg-white p-8 shadow-sm space-y-8">
      <div>
        <p class="text-[11px] tracking-[0.18em] uppercase text-[var(--accent)] font-semibold mb-2">Relocating</p>
        <h2 class="font-serif text-3xl text-stone-900 tracking-tight">Thinking about moving to Temecula?</h2>
        <p class="text-stone-600 mt-4 leading-relaxed">
          Many visitors fall for the valley on a tasting day. If you are exploring a move,
          <strong> Laura D. Farley, MBA</strong> offers local residential real estate guidance in Temecula Valley,
          with service also available in Orange County and Hacienda Heights.
        </p>
        <a
          href={hrefHome}
          class="inline-flex mt-6 items-center justify-center px-6 py-3 rounded-full bg-[var(--primary)] text-white text-sm font-medium hover:opacity-90 transition"
          rel="noopener noreferrer"
          target="_blank"
        >
          Visit lauradfarley.com →
        </a>
      </div>

      <div class="pt-8 border-t border-stone-100">
        <p class="text-[11px] tracking-[0.18em] uppercase text-[var(--accent)] font-semibold mb-2">Selling</p>
        <h2 class="font-serif text-2xl sm:text-3xl text-stone-900 tracking-tight">
          Estate owner looking to sell?
        </h2>
        <p class="text-stone-600 mt-4 leading-relaxed">
          Whether you own a hillside home, a wine-country property, or a family estate ready for the next chapter,
          Laura provides equal, strategic support for sellers — clear process, informed pricing conversations, and
          local market context.
        </p>
        <a
          href={hrefSell}
          class="inline-flex mt-6 items-center justify-center px-6 py-3 rounded-full border border-[var(--primary)] text-[var(--primary)] text-sm font-medium hover:bg-[var(--primary)] hover:text-white transition"
          rel="noopener noreferrer"
          target="_blank"
        >
          Sell with a local agent →
        </a>
      </div>
    </div>
  </section>
)}
