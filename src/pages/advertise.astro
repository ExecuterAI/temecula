---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import offer from '../data/featured-listing.json';

const checkoutUrl = offer.payment_link_url;
const priceDisplay = `$${(offer.amount_cents / 100).toFixed(0)}`;
const duration = offer.duration_days;
---

<Layout
  title="Advertise — Featured Winery Listing"
  description="Get a Featured listing on bellieacreswine.com — 30 days of highlighted placement for Temecula wineries and wine-country businesses. Secure checkout via Stripe."
>
  <Navbar />
  <main class="max-w-4xl mx-auto px-6 py-16">
    <p class="text-sm font-medium tracking-wide uppercase text-[var(--accent)] mb-3">For wineries & partners</p>
    <h1 class="text-5xl sm:text-6xl font-serif tracking-tight mb-4">Featured Listing</h1>
    <p class="text-xl text-stone-600 mb-10 max-w-2xl leading-relaxed">
      Put your Temecula Valley tasting room in front of visitors who are already planning where to go.
      Independent directory advertising on <strong>bellieacreswine.com</strong> — not a paid review and not an endorsement of quality.
    </p>

    <!-- Pricing card -->
    <div class="bg-white border border-stone-200 rounded-3xl p-8 sm:p-10 shadow-sm mb-12">
      <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-6 mb-8">
        <div>
          <div class="text-sm text-stone-500 mb-1">One-time · {duration} days</div>
          <div class="flex items-baseline gap-2">
            <span class="text-5xl font-serif text-stone-900">{priceDisplay}</span>
            <span class="text-stone-500">USD</span>
          </div>
          <p class="text-stone-600 mt-3 max-w-md">
            Featured Winery Listing — homepage/featured visibility, directory badge, and priority placement while active.
          </p>
        </div>
        <a
          href={checkoutUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center px-8 py-4 bg-[var(--primary)] hover:bg-black text-white text-base font-medium rounded-full transition shadow-sm"
        >
          Pay {priceDisplay} with Stripe
        </a>
      </div>

      <ul class="grid sm:grid-cols-2 gap-3 text-stone-700 text-sm">
        <li class="flex gap-2"><span class="text-[var(--gold)]">✓</span> Featured badge on your directory card</li>
        <li class="flex gap-2"><span class="text-[var(--gold)]">✓</span> Priority placement in featured areas</li>
        <li class="flex gap-2"><span class="text-[var(--gold)]">✓</span> {duration}-day run from activation date</li>
        <li class="flex gap-2"><span class="text-[var(--gold)]">✓</span> Secure card checkout (Stripe)</li>
        <li class="flex gap-2"><span class="text-[var(--gold)]">✓</span> Ideal for tasting rooms & wine-country stays</li>
        <li class="flex gap-2"><span class="text-[var(--gold)]">✓</span> We never sell alcohol on this site</li>
      </ul>
    </div>

    <!-- How it works -->
    <section class="mb-14">
      <h2 class="font-serif text-3xl mb-6">How it works</h2>
      <ol class="space-y-5">
        <li class="flex gap-4">
          <span class="shrink-0 w-9 h-9 rounded-full bg-[var(--primary)] text-white flex items-center justify-center font-medium">1</span>
          <div>
            <div class="font-medium text-stone-900">Checkout</div>
            <p class="text-stone-600 text-sm mt-1">Pay {priceDisplay} via the Stripe link above. You’ll get a Stripe receipt by email.</p>
          </div>
        </li>
        <li class="flex gap-4">
          <span class="shrink-0 w-9 h-9 rounded-full bg-[var(--primary)] text-white flex items-center justify-center font-medium">2</span>
          <div>
            <div class="font-medium text-stone-900">Send your details</div>
            <p class="text-stone-600 text-sm mt-1">
              Email <a class="text-[var(--accent)] underline" href="mailto:lauradfarley@gmail.com?subject=Featured%20Listing%20activation">lauradfarley@gmail.com</a>
              with: winery name, website, preferred photo/logo links, short blurb, contact phone, and the email used at checkout.
            </p>
          </div>
        </li>
        <li class="flex gap-4">
          <span class="shrink-0 w-9 h-9 rounded-full bg-[var(--primary)] text-white flex items-center justify-center font-medium">3</span>
          <div>
            <div class="font-medium text-stone-900">We activate</div>
            <p class="text-stone-600 text-sm mt-1">
              Typical activation within 1–3 business days after we receive complete details. Your {duration}-day window starts on the activation date.
            </p>
          </div>
        </li>
      </ol>
    </section>

    <!-- What’s included / not -->
    <section class="grid md:grid-cols-2 gap-6 mb-14">
      <div class="bg-stone-100 rounded-3xl p-7">
        <h2 class="font-serif text-2xl mb-3">Included</h2>
        <ul class="space-y-2 text-sm text-stone-700">
          <li>• One business / one listing per purchase</li>
          <li>• Featured styling + badge on the directory</li>
          <li>• Placement in featured/homepage modules when those modules are live</li>
          <li>• Reasonable copy/photo updates once during the run</li>
        </ul>
      </div>
      <div class="bg-stone-100 rounded-3xl p-7">
        <h2 class="font-serif text-2xl mb-3">Not included</h2>
        <ul class="space-y-2 text-sm text-stone-700">
          <li>• Not a star rating, review, or “#1 winery” claim</li>
          <li>• Not exclusive category ownership</li>
          <li>• Not guaranteed search-engine rankings</li>
          <li>• Not alcohol sales, tickets, or reservations processed by us</li>
        </ul>
      </div>
    </section>

    <!-- FAQ -->
    <section class="mb-14">
      <h2 class="font-serif text-3xl mb-6">FAQ</h2>
      <div class="space-y-5 text-stone-700">
        <div>
          <h3 class="font-medium text-stone-900">Who is this for?</h3>
          <p class="text-sm mt-1">Temecula-area wineries, tasting rooms, and closely related wine-country experiences that fit an independent visitor directory.</p>
        </div>
        <div>
          <h3 class="font-medium text-stone-900">Can I renew?</h3>
          <p class="text-sm mt-1">Yes — purchase again before or after your run ends, or email us about multi-month options.</p>
        </div>
        <div>
          <h3 class="font-medium text-stone-900">Refunds</h3>
          <p class="text-sm mt-1">
            Full refund if we have not activated your listing and you request it within 7 days of payment.
            After activation, fees are generally non-refundable except where required by law. See
            <a class="underline" href="/terms">Terms</a>.
          </p>
        </div>
        <div>
          <h3 class="font-medium text-stone-900">Questions before paying?</h3>
          <p class="text-sm mt-1">
            <a class="text-[var(--accent)] underline" href="/contact">Contact us</a>
            or email <a class="text-[var(--accent)] underline" href="mailto:lauradfarley@gmail.com">lauradfarley@gmail.com</a>.
          </p>
        </div>
      </div>
    </section>

    <!-- Final CTA -->
    <div class="rounded-3xl bg-[var(--primary)] text-white p-8 sm:p-10 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6">
      <div>
        <div class="font-serif text-3xl mb-2">Ready to feature your winery?</div>
        <p class="text-white/80 text-sm max-w-md">Secure checkout powered by Stripe. Activation starts after you send listing details.</p>
      </div>
      <a
        href={checkoutUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center px-8 py-4 bg-white text-[var(--primary)] hover:bg-stone-100 text-base font-medium rounded-full transition whitespace-nowrap"
      >
        Get Featured — {priceDisplay}
      </a>
    </div>

    <p class="text-xs text-stone-500 mt-8">
      Payments are processed by Stripe, Inc. Card statement may show a descriptor related to The Executer / Bellie Acres.
      This site is an independent directory; featured placement is advertising inventory, not a guarantee of visitor volume.
      21+ for alcohol tastings. Drink responsibly.
    </p>
  </main>
</Layout>
