---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
---

<Layout
  title="Contact"
  description="Contact Bellie Acres Wine at bellieacreswine.com — corrections, partnerships, and general questions about our Temecula winery directory."
>
  <Navbar />
  <main class="max-w-3xl mx-auto px-6 py-16">
    <h1 class="text-5xl font-serif tracking-tight mb-4">Contact</h1>
    <p class="text-xl text-stone-600 mb-10">
      Questions, listing corrections, or partnership inquiries for the independent Temecula wine-country directory at
      <strong>bellieacreswine.com</strong>.
    </p>

    <div class="bg-white border border-stone-200 rounded-3xl p-8 mb-10 space-y-4">
      <div>
        <div class="text-sm text-stone-500">Email</div>
        <a class="text-lg text-[var(--accent)] hover:underline font-medium" href="mailto:lauradfarley@gmail.com?subject=Bellie%20Acres%20Wine%20site">
          lauradfarley@gmail.com
        </a>
      </div>
      <div>
        <div class="text-sm text-stone-500">Website</div>
        <div class="text-lg">https://bellieacreswine.com</div>
      </div>
      <div>
        <div class="text-sm text-stone-500">Response time</div>
        <div class="text-stone-700">We aim to reply within 2–3 business days.</div>
      </div>
      <div class="pt-2 border-t border-stone-100">
        <div class="text-sm text-stone-500 mb-1">Winery advertising</div>
        <a class="text-[var(--accent)] hover:underline font-medium" href="/advertise">
          Featured Listing — $49 / 30 days
        </a>
      </div>
    </div>

    <div class="bg-stone-100 rounded-3xl p-8">
      <h2 class="font-serif text-2xl mb-4">Send a message</h2>
      <p class="text-stone-600 mb-6 text-sm">
        This form opens your email app with your message addressed to us (no data is stored on this server).
      </p>
      <form
        class="space-y-4"
        method="get"
        action="mailto:lauradfarley@gmail.com"
        enctype="text/plain"
        onsubmit="
          event.preventDefault();
          const n = document.getElementById('name').value.trim();
          const e = document.getElementById('email').value.trim();
          const m = document.getElementById('message').value.trim();
          const body = encodeURIComponent('Name: ' + n + '\\nEmail: ' + e + '\\n\\n' + m);
          const sub = encodeURIComponent('Bellie Acres Wine contact from ' + (n || 'site visitor'));
          window.location.href = 'mailto:lauradfarley@gmail.com?subject=' + sub + '&body=' + body;
        "
      >
        <div>
          <label class="block text-sm font-medium mb-1" for="name">Name</label>
          <input id="name" name="name" required class="w-full px-4 py-3 rounded-2xl border border-stone-300" />
        </div>
        <div>
          <label class="block text-sm font-medium mb-1" for="email">Your email</label>
          <input id="email" name="email" type="email" required class="w-full px-4 py-3 rounded-2xl border border-stone-300" />
        </div>
        <div>
          <label class="block text-sm font-medium mb-1" for="message">Message</label>
          <textarea id="message" name="message" required rows="5" class="w-full px-4 py-3 rounded-2xl border border-stone-300"></textarea>
        </div>
        <button type="submit" class="px-6 py-3 bg-[var(--primary)] text-white rounded-full font-medium hover:bg-black transition">
          Open email to send
        </button>
      </form>
    </div>

    <p class="text-sm text-stone-500 mt-10">
      See also our <a class="underline" href="/privacy">Privacy Policy</a> and <a class="underline" href="/terms">Terms of Use</a>.
    </p>
  </main>
</Layout>
