---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import wineries from '../data/wineries.json';
import siteSearch from '../data/site-search.json';

const wineryIndex = wineries.map((w) => ({
  name: w.name,
  slug: w.slug,
  location: w.location || '',
  blob: [
    w.name,
    w.location,
    w.price_range,
    ...(w.varietals || []),
    w.pet_friendly ? 'pet friendly dog friendly dogs welcome pets dog dogs' : '',
    w.kid_friendly?.allowed ? 'kid friendly family children kids' : '',
    w.has_views ? ['view views scenic', ...(w.view_tags || [])].join(' ') : '',
    w.slug,
  ]
    .filter(Boolean)
    .join(' ')
    .toLowerCase(),
}));
---

<Layout
  title="Search"
  description="Search Bellie Acres Wine — Temecula wineries, guides, Fun Puns, pairings, map, and events."
>
  <Navbar />
  <main class="max-w-3xl mx-auto px-4 sm:px-6 py-10 sm:py-16">
    <p class="text-[11px] tracking-[0.28em] uppercase text-[#4A5E4E] font-medium mb-3">Bellie Acres Wine</p>
    <h1 class="font-serif text-4xl sm:text-5xl text-[#2B322C] tracking-tight mb-6">Search</h1>

    <form id="search-form" action="/search/" method="get" role="search" class="mb-8">
      <label for="q" class="sr-only">Search this site</label>
      <div class="flex flex-col gap-3">
        <input
          id="q"
          name="q"
          type="search"
          enterkeyhint="search"
          autocapitalize="none"
          autocomplete="off"
          placeholder="Try dog friendly, puns, events…"
          class="w-full min-h-12 px-5 py-3.5 border border-stone-300 rounded-2xl text-base sm:text-lg bg-white focus:outline-none focus:border-[#4A5E4E]"
        />
        <button
          type="submit"
          class="w-full sm:w-auto min-h-12 px-6 py-3.5 rounded-full bg-[#4A5E4E] text-white font-medium hover:opacity-90"
        >
          Search
        </button>
      </div>
    </form>

    <div id="search-results">
      <p class="text-stone-600 leading-relaxed text-base">
        Type a word and tap Search.
      </p>
    </div>
  </main>

  <script type="application/json" id="search-page-data">{JSON.stringify(siteSearch)}</script>
  <script type="application/json" id="search-winery-data">{JSON.stringify(wineryIndex)}</script>

  <script>
    (function () {
      var input = document.getElementById('q');
      var out = document.getElementById('search-results');
      var form = document.getElementById('search-form');

      function readJson(id) {
        var el = document.getElementById(id);
        if (!el) return [];
        try {
          return JSON.parse(el.textContent || '[]');
        } catch (e) {
          return [];
        }
      }

      var pageList = readJson('search-page-data');
      var wineryList = readJson('search-winery-data');

      var shortcuts = {
        events: '/events/',
        event: '/events/',
        puns: '/guides/good-wine-no-whine/',
        pun: '/guides/good-wine-no-whine/',
        'fun puns': '/guides/good-wine-no-whine/',
        wineries: '/wineries/',
        winery: '/wineries/',
        pairings: '/pairings/',
        pairing: '/pairings/',
        map: '/map/',
        guides: '/guides/',
        harvest: '/guides/temecula-harvest-season/',
        halloween: '/guides/temecula-halloween-fall-family/',
        holiday: '/guides/temecula-holiday-wine-country/',
        christmas: '/guides/temecula-holiday-wine-country/',
        balloons: '/balloons/',
        contact: '/contact/',
        about: '/about/'
      };

      function esc(s) {
        return String(s)
          .replace(/&/g, '&amp;')
          .replace(/</g, '&lt;')
          .replace(/"/g, '&quot;');
      }

      function tokens(s) {
        return String(s || '')
          .toLowerCase()
          .split(/[^a-z0-9]+/)
          .filter(function (t) {
            return t.length >= 2;
          });
      }

      function haystackHas(hay, query) {
        var words = tokens(query);
        if (!words.length) return false;
        hay = String(hay || '').toLowerCase();
        return words.every(function (t) {
          return hay.indexOf(t) !== -1;
        });
      }

      function go(href) {
        window.location.href = href;
      }

      function card(href, title, blurb, serif) {
        return (
          '<li><a class="block rounded-2xl border border-stone-200 bg-white px-5 py-4 min-h-14" href="' +
          href +
          '"><span class="' +
          (serif ? 'font-serif text-xl' : 'font-medium text-base sm:text-lg') +
          ' text-[#2B322C]">' +
          esc(title) +
          '</span>' +
          (blurb
            ? '<span class="block text-sm text-stone-600 mt-1">' + esc(blurb) + '</span>'
            : '') +
          '</a></li>'
        );
      }

      function run(qRaw, jump) {
        var q = String(qRaw || '').trim();
        if (input) input.value = q;
        if (!q) {
          if (out) {
            out.innerHTML = '<p class="text-stone-600 leading-relaxed">Type a word and tap Search.</p>';
          }
          return;
        }

        var key = q.toLowerCase();
        if (jump && shortcuts[key]) {
          go(shortcuts[key]);
          return;
        }

        var pageHits = pageList.filter(function (p) {
          return haystackHas(p.title + ' ' + p.blurb + ' ' + p.keywords, key);
        });
        var wineryHits = wineryList.filter(function (w) {
          return haystackHas((w.blob || '') + ' ' + (w.name || ''), key);
        });

        if (!out) return;

        if (!pageHits.length && !wineryHits.length) {
          out.innerHTML =
            '<p class="text-stone-600">Nothing matched <strong class="text-[#2B322C]">“' +
            esc(q) +
            '”</strong>. Try dog friendly, puns, harvest, or a winery name.</p>';
          return;
        }

        var html = '<p class="text-stone-600 mb-6">Results for <strong class="text-[#2B322C]">“' + esc(q) + '”</strong></p>';
        html += '<ul class="space-y-3">';
        pageHits.forEach(function (p) {
          html += card(p.href, p.title, p.blurb, false);
        });
        wineryHits.forEach(function (w) {
          html += card('/wineries/' + w.slug, w.name, w.location || '', true);
        });
        html += '</ul>';
        out.innerHTML = html;
      }

      if (form) {
        form.addEventListener('submit', function (e) {
          e.preventDefault();
          var q = input ? String(input.value || '').trim() : '';
          if (!q) {
            run('', false);
            return;
          }
          if (shortcuts[q.toLowerCase()]) {
            go(shortcuts[q.toLowerCase()]);
            return;
          }
          if (window.history && window.history.replaceState) {
            window.history.replaceState(null, '', '/search/?q=' + encodeURIComponent(q));
          }
          run(q, false);
        });
      }

      var params = new URLSearchParams(window.location.search);
      var initial = params.get('q') || '';
      if (initial) run(initial, !!(shortcuts[initial.toLowerCase()]));
    })();
  </script>
</Layout>
