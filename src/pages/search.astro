---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import wineries from '../data/wineries.json';
import siteSearch from '../data/site-search.json';

const wineryIndex = wineries.map((w) => ({
  name: w.name,
  slug: w.slug,
  location: w.location || '',
  blob: [
    w.name,
    w.location,
    w.price_range,
    ...(w.varietals || []),
    w.pet_friendly ? 'pet friendly dog friendly dogs welcome pets dog dogs' : '',
    w.kid_friendly?.allowed ? 'kid friendly family children kids' : '',
    w.has_views ? ['view views scenic', ...(w.view_tags || [])].join(' ') : '',
    w.slug,
  ]
    .filter(Boolean)
    .join(' ')
    .toLowerCase(),
}));
---

<Layout
  title="Search"
  description="Search Bellie Acres Wine — Temecula wineries, guides, Fun Puns, pairings, map, and events."
>
  <Navbar />
  <main class="max-w-3xl mx-auto px-6 py-12 sm:py-16">
    <p class="text-[11px] tracking-[0.28em] uppercase text-[#4A5E4E] font-medium mb-3">Bellie Acres Wine</p>
    <h1 class="font-serif text-4xl sm:text-5xl text-[#2B322C] tracking-tight mb-6">Search</h1>

    <form id="search-form" action="/search/" method="get" role="search" class="mb-10">
      <label for="q" class="sr-only">Search this site</label>
      <div class="flex flex-col sm:flex-row gap-3">
        <input
          id="q"
          name="q"
          type="search"
          enterkeyhint="search"
          autocapitalize="none"
          autocomplete="off"
          placeholder="Try events, puns, or wineries"
          class="flex-1 px-5 py-3.5 border border-stone-300 rounded-2xl text-lg bg-white focus:outline-none focus:border-[#4A5E4E]"
        />
        <button type="submit" class="px-6 py-3.5 rounded-full bg-[#4A5E4E] text-white font-medium hover:opacity-90">
          Search
        </button>
      </div>
    </form>

    <div id="search-results">
      <p class="text-stone-600 leading-relaxed">
        Type a word and tap Search. Shortcuts: <strong>events</strong>, <strong>puns</strong>, <strong>wineries</strong>.
      </p>
    </div>
  </main>

  <script define:vars={{ pages: siteSearch, wineries: wineryIndex }}>
    (function () {
      var input = document.getElementById('q');
      var out = document.getElementById('search-results');
      var form = document.getElementById('search-form');
      var pageList = pages || [];
      var wineryList = wineries || [];

      var shortcuts = {
        events: '/events/',
        event: '/events/',
        puns: '/guides/good-wine-no-whine/',
        pun: '/guides/good-wine-no-whine/',
        'fun puns': '/guides/good-wine-no-whine/',
        'fun pun': '/guides/good-wine-no-whine/',
        wineries: '/wineries/',
        winery: '/wineries/',
        pairings: '/pairings/',
        pairing: '/pairings/',
        map: '/map/',
        guides: '/guides/',
        harvest: '/guides/temecula-harvest-season/',
        halloween: '/guides/temecula-halloween-fall-family/',
        holiday: '/guides/temecula-holiday-wine-country/',
        christmas: '/guides/temecula-holiday-wine-country/',
        balloons: '/balloons/',
        contact: '/contact/',
        about: '/about/'
      };

      function esc(s) {
        return String(s)
          .replace(/&/g, '&amp;')
          .replace(/</g, '&lt;')
          .replace(/"/g, '&quot;');
      }

      function tokens(s) {
        return String(s || '')
          .toLowerCase()
          .split(/[^a-z0-9]+/)
          .filter(function (t) { return t.length >= 2; });
      }

      function haystackHas(hay, query) {
        var words = tokens(query);
        if (!words.length) return false;
        hay = String(hay || '').toLowerCase();
        return words.every(function (t) { return hay.indexOf(t) !== -1; });
      }

      function go(href) {
        window.location.href = href;
      }

      function run(qRaw, jump) {
        var q = String(qRaw || '').trim();
        if (input) input.value = q;
        if (!q) {
          if (out) {
            out.innerHTML =
              '<p class="text-stone-600 leading-relaxed">Type a word and tap Search. Shortcuts: <strong>events</strong>, <strong>puns</strong>, <strong>wineries</strong>.</p>';
          }
          return;
        }

        var key = q.toLowerCase();
        if (jump && shortcuts[key]) {
          go(shortcuts[key]);
          return;
        }

        var pageHits = pageList.filter(function (p) {
          return haystackHas(p.title + ' ' + p.blurb + ' ' + p.keywords, key);
        });
        var wineryHits = wineryList.filter(function (w) {
          return haystackHas((w.blob || '') + ' ' + (w.name || ''), key);
        });

        if (jump && pageHits.length === 1 && wineryHits.length === 0) {
          go(pageHits[0].href);
          return;
        }

        if (!out) return;
        var html = '<p class="text-stone-600 mb-8">Results for <strong class="text-[#2B322C]">“' + esc(q) + '”</strong></p>';
        html += '<section class="mb-10"><h2 class="font-serif text-2xl text-[#2B322C] mb-4">Pages</h2>';
        if (pageHits.length) {
          html += '<ul class="space-y-3">';
          pageHits.forEach(function (p) {
            html +=
              '<li><a class="block rounded-2xl border border-[#9AAB97]/40 bg-[#F6F7F2] px-5 py-4" href="' +
              p.href +
              '"><span class="font-medium text-[#2B322C]">' +
              esc(p.title) +
              '</span><span class="block text-sm text-stone-600 mt-1">' +
              esc(p.blurb) +
              '</span></a></li>';
          });
          html += '</ul>';
        } else {
          html += '<p class="text-stone-500">No matching pages.</p>';
        }
        html += '</section><section><h2 class="font-serif text-2xl text-[#2B322C] mb-4">Wineries</h2>';
        if (wineryHits.length) {
          html += '<ul class="space-y-3">';
          wineryHits.forEach(function (w) {
            html +=
              '<li><a class="block rounded-2xl border border-stone-200 bg-white px-5 py-4" href="/wineries/' +
              w.slug +
              '"><span class="font-serif text-xl text-[#2B322C]">' +
              esc(w.name) +
              '</span><span class="block text-sm text-stone-600 mt-1">' +
              esc(w.location || '') +
              '</span></a></li>';
          });
          html += '</ul>';
        } else {
          html += '<p class="text-stone-500">No matching tasting rooms.</p>';
        }
        html += '</section>';
        out.innerHTML = html;
      }

      function submitSearch(jump) {
        var q = input ? String(input.value || '').trim() : '';
        if (!q) {
          run('', false);
          return;
        }
        if (jump && shortcuts[q.toLowerCase()]) {
          go(shortcuts[q.toLowerCase()]);
          return;
        }
        if (window.history && window.history.replaceState) {
          window.history.replaceState(null, '', '/search/?q=' + encodeURIComponent(q));
        }
        run(q, jump);
      }

      if (form) {
        form.addEventListener('submit', function (e) {
          e.preventDefault();
          submitSearch(true);
        });
      }

      var params = new URLSearchParams(window.location.search);
      var initial = params.get('q') || '';
      if (initial) run(initial, true);
    })();
  </script>
</Layout>
