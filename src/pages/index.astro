---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import wineries from '../data/wineries.json';
import balloons from '../data/balloons.json';

const featured = wineries.filter(w => w.featured);
const featuredBalloons = balloons.slice(0, 3);

const searchBlob = (w: (typeof wineries)[number]) => {
  const bits = [
    w.name,
    w.location,
    w.price_range,
    ...(w.varietals || []),
    w.pet_friendly ? 'pet friendly dogs' : '',
    w.kid_friendly?.allowed ? 'kid friendly family children' : '',
    w.slug,
  ];
  return bits.filter(Boolean).join(' ').toLowerCase();
};

// Wine Word of the Day (rotates daily based on date)
const wineWords = [
  { term: "Terroir", definition: "The unique combination of soil, climate, and topography that gives wine its distinctive character." },
  { term: "Malolactic Fermentation", definition: "A secondary fermentation that converts sharp malic acid into softer, creamier lactic acid." },
  { term: "Cuvée", definition: "A blend of wines, often used for sparkling wines and Champagne." },
  { term: "Appellation", definition: "A legally defined geographic region known for producing wines with specific characteristics." },
  { term: "Brix", definition: "A measurement of sugar content in grapes, used to predict potential alcohol levels." },
];

const today = new Date().getDate();
const wordOfTheDay = wineWords[today % wineWords.length];
---

<Layout title="Discover Temecula Wineries">
  <Navbar />

  <main>
    <!-- Hero -->
    <section class="relative h-[68vh] flex items-center justify-center bg-[url('/hero-bg.jpg')] bg-cover bg-center">
      <div class="absolute inset-0 bg-gradient-to-b from-black/35 via-black/30 to-black/50"></div>
      
      <div class="relative z-10 text-center px-6 max-w-5xl">
        <div class="inline-block px-4 py-1 rounded-full bg-white/10 text-white text-sm tracking-[3px] mb-6">
          TEMECULA VALLEY • SINCE 1969
        </div>
        
        <h1 class="text-6xl md:text-7xl font-serif text-white tracking-[-3px] leading-none mb-6">
          Wine Country,<br> Elevated.
        </h1>
        
        <p class="max-w-md mx-auto text-lg text-white/80 mb-8">
          Thoughtfully curated experiences across 41 of Temecula’s finest wineries.
        </p>
        
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="#explore" class="px-8 py-3.5 bg-white text-stone-900 rounded-full font-medium hover:bg-white/90 transition">
            Explore the Wineries
          </a>
          <a href="/map" class="px-8 py-3.5 border border-white/70 text-white rounded-full font-medium hover:bg-white/10 transition">
            View Map
          </a>
          <a href="#balloons" class="px-8 py-3.5 bg-amber-600 text-white rounded-full font-medium hover:bg-amber-700 transition">
            Hot Air Balloon Rides
          </a>
        </div>
      </div>
    </section>

    <!-- Trust Bar -->
    <div class="border-b border-stone-200 bg-white">
      <div class="max-w-6xl mx-auto px-6 py-5 flex flex-wrap justify-center gap-x-12 gap-y-3 text-sm text-stone-600">
        <div>41 Wineries</div>
        <div>4.6 Average Rating</div>
        <div>Family & Pet Friendly Options</div>
        <div>Live Music Weekly</div>
      </div>
    </div>

    <!-- Wine Word of the Day -->
    <section class="max-w-4xl mx-auto px-6 py-10">
      <div class="bg-white border border-stone-200 rounded-3xl p-8 md:p-10">
        <div class="flex items-center gap-3 mb-4">
          <div class="text-2xl">🍷</div>
          <div class="uppercase tracking-[2px] text-xs font-medium text-[var(--accent)]">Wine Word of the Day</div>
        </div>
        <h3 class="font-serif text-4xl tracking-tight mb-3">{wordOfTheDay.term}</h3>
        <p class="text-xl text-stone-700 leading-relaxed">{wordOfTheDay.definition}</p>
        <p class="text-xs text-stone-500 mt-6">New word every day • Come back tomorrow</p>
      </div>
    </section>

    <!-- Featured Estates -->
    <section id="explore" class="max-w-6xl mx-auto px-6 py-12">
      <div class="flex justify-between items-baseline mb-10">
        <div>
          <h2 class="text-5xl font-serif tracking-tight">Featured Estates</h2>
          <p class="text-xl text-stone-600 mt-2">Our current recommendations</p>
        </div>
        <a href="/wineries" class="text-[var(--accent)] hover:underline text-lg">See all wineries →</a>
      </div>

      <!-- Search Bar -->
      <div class="mb-8 max-w-md">
        <label for="search-input" class="sr-only">Search featured wineries</label>
        <input
          type="search"
          id="search-input"
          placeholder="Search wineries by name, varietal, or vibe..."
          autocomplete="off"
          class="w-full px-5 py-3.5 border border-stone-300 rounded-2xl focus:outline-none focus:border-[var(--accent)] text-lg bg-white"
        />
      </div>

      <div id="winery-grid" class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        {featured.map(winery => (
          <a
            href={`/wineries/${winery.slug}`}
            class="winery-card group block rounded-3xl overflow-hidden border border-stone-200 bg-white hover:shadow-xl transition"
            data-search={searchBlob(winery)}
          >
            <div class="h-56 overflow-hidden relative">
              <img 
                src={winery.image} 
                alt={winery.name}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              />
              <span class="absolute top-3 left-3 text-xs font-medium px-3 py-1 rounded-full bg-[var(--gold)] text-[var(--primary)] shadow">
                Featured
              </span>
            </div>
            <div class="p-6">
              <div class="flex justify-between items-start mb-3">
                <div>
                  <h3 class="font-serif text-2xl group-hover:text-[var(--accent)] transition leading-tight">{winery.name}</h3>
                  <p class="text-stone-600 mt-0.5">{winery.location} • {winery.price_range}</p>
                </div>
                <div class="text-right">
                  <div class="font-semibold text-xl">{winery.rating}</div>
                  <div class="text-[10px] text-stone-500 -mt-1">rating</div>
                </div>
              </div>

              <div class="flex flex-wrap gap-2 mt-4">
                <span class="text-xs px-3 py-1 bg-[var(--gold)]/20 text-[var(--primary)] rounded-full font-medium">Featured</span>
                {winery.pet_friendly && (
                  <span class="text-xs px-3 py-1 bg-emerald-100 text-emerald-700 rounded-full">Pet Friendly</span>
                )}
                {winery.kid_friendly?.allowed && (
                  <span class="text-xs px-3 py-1 bg-amber-100 text-amber-700 rounded-full">Kid Friendly</span>
                )}
                <span class="text-xs px-3 py-1 bg-stone-100 text-stone-600 rounded-full">{winery.varietals[0]}</span>
              </div>
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- Guides -->
    <section class="max-w-6xl mx-auto px-6 py-16 border-t border-stone-200">
      <div class="flex justify-between items-baseline mb-10">
        <div>
          <h2 class="text-5xl font-serif tracking-tight">Trip Guides</h2>
          <p class="text-xl text-stone-600 mt-2">Practical planning, not window dressing</p>
        </div>
        <a href="/guides" class="text-[var(--accent)] hover:underline text-lg">All guides →</a>
      </div>
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        <a href="/pairings" class="group block rounded-3xl border border-stone-200 bg-white p-8 hover:shadow-xl transition">
          <div class="text-xs uppercase tracking-[2px] text-[var(--accent)] font-medium mb-3">Pairings</div>
          <h3 class="font-serif text-3xl group-hover:text-[var(--accent)] transition">Wine Pairing Suggestions</h3>
          <p class="text-stone-600 mt-4 leading-relaxed">Food matches by wine type, protein, occasion, and season — with Temecula winery examples.</p>
          <div class="mt-6 text-[var(--accent)] font-medium">Browse pairings →</div>
        </a>
        <a href="/guides/first-timer-tasting-route" class="group block rounded-3xl border border-stone-200 bg-white p-8 hover:shadow-xl transition">
          <div class="text-xs uppercase tracking-[2px] text-[var(--accent)] font-medium mb-3">Planning</div>
          <h3 class="font-serif text-3xl group-hover:text-[var(--accent)] transition">First-Timer Tasting Route</h3>
          <p class="text-stone-600 mt-4 leading-relaxed">A realistic three-stop day on the Rancho California spine — timing, food, transport, and mistakes to skip.</p>
          <div class="mt-6 text-[var(--accent)] font-medium">Read guide →</div>
        </a>
        <a href="/guides/pet-friendly-wineries" class="group block rounded-3xl border border-stone-200 bg-white p-8 hover:shadow-xl transition">
          <div class="text-xs uppercase tracking-[2px] text-[var(--accent)] font-medium mb-3">Pets</div>
          <h3 class="font-serif text-3xl group-hover:text-[var(--accent)] transition">Pet-Friendly Wineries</h3>
          <p class="text-stone-600 mt-4 leading-relaxed">Which estates welcome dogs, outdoor patio rules, packing list, and resorts that are typically no-pet.</p>
          <div class="mt-6 text-[var(--accent)] font-medium">Read guide →</div>
        </a>
      </div>
    </section>

    <!-- Hot Air Balloon Rides -->
    <section id="balloons" class="max-w-6xl mx-auto px-6 py-16 border-t border-stone-200">
      <div class="flex justify-between items-baseline mb-10">
        <div>
          <h2 class="text-5xl font-serif tracking-tight">Hot Air Balloon Rides</h2>
          <p class="text-xl text-stone-600 mt-2">Float above the vineyards at sunrise</p>
        </div>
        <a href="/balloons" class="text-[var(--accent)] hover:underline text-lg">See all operators →</a>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        {featuredBalloons.map((b) => (
          <a href={`/balloons/${b.slug}`} class="group block rounded-3xl overflow-hidden border border-stone-200 bg-white hover:shadow-xl transition">
            <div class="h-56 overflow-hidden">
              <img
                src={b.image}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                alt={`Hot air balloon — ${b.name}`}
                loading="lazy"
              />
            </div>
            <div class="p-6">
              <h3 class="font-serif text-2xl group-hover:text-[var(--accent)] transition">{b.name}</h3>
              <p class="text-stone-600 mt-1">{b.tagline}</p>
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- Winery advertising -->
    <section class="max-w-6xl mx-auto px-6 py-16 border-t border-stone-200">
      <div class="rounded-3xl bg-[var(--primary)] text-white p-8 sm:p-10 flex flex-col md:flex-row md:items-center md:justify-between gap-6">
        <div>
          <div class="text-sm uppercase tracking-[2px] text-white/70 mb-2">For wineries</div>
          <h2 class="font-serif text-3xl sm:text-4xl tracking-tight">Featured Listing — $49 / 30 days</h2>
          <p class="text-white/80 mt-3 max-w-xl">Highlighted placement on this independent Temecula wine directory. Secure checkout via Stripe.</p>
        </div>
        <a
          href="/advertise"
          class="inline-flex items-center justify-center px-8 py-4 bg-white text-[var(--primary)] hover:bg-stone-100 rounded-full font-medium transition whitespace-nowrap"
        >
          Advertise with us →
        </a>
      </div>
    </section>
  </main>

  <script>
    const input = document.getElementById('search-input') as HTMLInputElement | null;
    const cards = Array.from(document.querySelectorAll<HTMLElement>('#winery-grid .winery-card'));

    function filterWineries() {
      if (!input) return;
      const q = input.value.trim().toLowerCase();
      for (const card of cards) {
        const hay = card.dataset.search || card.textContent?.toLowerCase() || '';
        card.classList.toggle('hidden', !!(q && !hay.includes(q)));
      }
    }

    input?.addEventListener('input', filterWineries);
    input?.addEventListener('search', filterWineries);
  </script>
</Layout>
