---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import RelocateCta from '../components/RelocateCta.astro';
import wineries from '../data/wineries.json';
import balloons from '../data/balloons.json';
import wineCollection from '../data/wine-collection.json';

const featured = wineries.filter(w => w.featured);
const featuredBalloons = balloons.slice(0, 3);
const collectionFeatured = wineCollection.titles.filter((t) => t.homepageFeatured).slice(0, 6);
const collectionIntro = wineCollection.homepageIntro;

const searchBlob = (w: (typeof wineries)[number]) => {
  const bits = [
    w.name,
    w.location,
    w.price_range,
    ...(w.varietals || []),
    w.pet_friendly ? 'pet friendly dogs' : '',
    w.kid_friendly?.allowed ? 'kid friendly family children' : '',
    w.has_views
      ? [
          'view views scenic overlook panoramic vista',
          'sip with a view',
          'tasting with a view',
          'drink in the views',
          ...(w.view_tags || []),
        ].join(' ')
      : '',
    w.slug,
  ];
  return bits.filter(Boolean).join(' ').toLowerCase();
};

// Wine Word of the Day (rotates daily based on date)
const wineWords = [
  { term: "Terroir", definition: "The unique combination of soil, climate, and topography that gives wine its distinctive character." },
  { term: "Malolactic Fermentation", definition: "A secondary fermentation that converts sharp malic acid into softer, creamier lactic acid." },
  { term: "Cuvée", definition: "A blend of wines, often used for sparkling wines and Champagne." },
  { term: "Appellation", definition: "A legally defined geographic region known for producing wines with specific characteristics." },
  { term: "Brix", definition: "A measurement of sugar content in grapes, used to predict potential alcohol levels." },
];

const today = new Date().getDate();
const wordOfTheDay = wineWords[today % wineWords.length];
const wineryCount = wineries.length;

const homeJsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'Bellie Acres Wine',
    alternateName: [
      'Temecula Wine Directory',
      'Temecula Wineries',
      'Temecula Wineries List',
      'List of Wineries in Temecula',
      'Temecula Wineries Map',
      'Temecula Wine Map',
    ],
    url: 'https://bellieacreswine.com/',
    description:
      'Independent guide to Temecula wineries — full list of wineries in Temecula, Temecula wine map, pairings, and trip planning.',
    potentialAction: {
      '@type': 'SearchAction',
      target: 'https://bellieacreswine.com/wineries/?q={search_term_string}',
      'query-input': 'required name=search_term_string',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: 'Bellie Acres Wine',
    url: 'https://bellieacreswine.com/',
    email: 'executerceo@gmail.com',
    description: 'Independent Temecula Valley wine-country directory — not a winery or alcohol retailer.',
    areaServed: {
      '@type': 'Place',
      name: 'Temecula Valley, California',
    },
  },
];
---

<Layout
  title="Temecula Wineries · List of Wineries in Temecula & Wine Map"
  description={`Temecula wineries directory: full list of wineries in Temecula (${wineryCount}+ estates), Temecula wineries list, interactive Temecula wine map / Temecula wineries map, pairings, and trip guides. Independent guide — not a winery.`}
  jsonLd={homeJsonLd}
>
  <Navbar />

  <main>
    <!-- Hero -->
    <section class="relative h-[68vh] flex items-center justify-center bg-[url('/images/hero-estate-v20260728.jpg')] bg-cover bg-center">
      <div class="absolute inset-0 bg-gradient-to-b from-[#2B322C]/25 via-[#2B322C]/30 to-[#2B322C]/55"></div>
      
      <div class="relative z-10 text-center px-6 max-w-5xl">
        <div class="inline-block px-4 py-1 rounded-full bg-white/15 backdrop-blur-[2px] text-white text-sm tracking-[3px] mb-6 border border-white/20">
          TEMECULA VALLEY WINE COUNTRY
        </div>
        
        <h1 class="text-5xl sm:text-6xl md:text-7xl font-serif text-white tracking-[-2px] leading-[1.05] mb-6">
          Temecula Wineries
        </h1>
        
        <p class="max-w-2xl mx-auto text-lg md:text-xl text-white/90 mb-3">
          Independent directory · list of wineries in Temecula · wine map
        </p>
        <p class="max-w-xl mx-auto text-base text-white/80 mb-8">
          Browse the full Temecula wineries list, open the Temecula wine map, shortlist the best stops for your day, and plan with pairings and practical guides.
        </p>
        
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="/wineries" class="px-8 py-3.5 bg-white text-[#2B322C] rounded-full font-medium hover:bg-[#F6F7F2] transition">
            Temecula wineries list
          </a>
          <a href="/map" class="px-8 py-3.5 border border-white/70 text-white rounded-full font-medium hover:bg-white/10 transition">
            Temecula wine map
          </a>
          <a href="/guides/best-temecula-wineries" class="px-8 py-3.5 bg-[#4A5E4E] text-white rounded-full font-medium hover:bg-[#3a4a3d] transition shadow-lg shadow-black/15">
            Best Temecula wineries
          </a>
        </div>
      </div>
    </section>

    <!-- Trust Bar -->
    <div class="border-b border-stone-200 bg-white">
      <div class="max-w-6xl mx-auto px-6 py-5 flex flex-wrap justify-center gap-x-12 gap-y-3 text-sm text-stone-600">
        <div>{wineryCount} Wineries listed</div>
        <div>Directory · List · Map</div>
        <div>Family & Pet Friendly Options</div>
        <div>Independent guide</div>
      </div>
    </div>

    <!-- SEO intro + intent hubs -->
    <section class="max-w-6xl mx-auto px-6 py-12">
      <div class="grid lg:grid-cols-5 gap-10 items-start">
        <div class="lg:col-span-3">
          <h2 class="text-3xl sm:text-4xl font-serif tracking-tight text-stone-900 mb-4">
            Plan Temecula wineries without twenty browser tabs
          </h2>
          <p class="text-lg text-stone-700 leading-relaxed">
            Bellie Acres Wine is an independent guide to <strong>Temecula wineries</strong> — a practical
            <strong>list of wineries in Temecula</strong> built for trip planning. Use our
            <strong>Temecula wineries list</strong> to compare estates by vibe, varietals, pet and family policies, and price feel —
            then open the <a href="/map" class="text-[var(--accent)] underline"><strong>Temecula wine map</strong></a>, pairings, and guides when you are ready to build a route.
          </p>
          <p class="text-lg text-stone-700 leading-relaxed mt-4">
            Looking for the <strong>best Temecula winery</strong> for a first visit, a celebration, or a relaxed patio afternoon?
            Start with featured estates below, or read our curated best-of guide. We do not sell alcohol here — we help you choose where to taste.
          </p>
        </div>
        <div class="lg:col-span-2 grid sm:grid-cols-2 lg:grid-cols-1 gap-3">
          <a href="/wineries" class="rounded-2xl border border-stone-200 bg-white p-5 hover:shadow-md transition">
            <div class="text-xs uppercase tracking-[2px] text-[var(--accent)] font-medium">List</div>
            <div class="font-serif text-xl mt-1">List of wineries in Temecula</div>
          </a>
          <a href="/map" class="rounded-2xl border border-stone-200 bg-white p-5 hover:shadow-md transition">
            <div class="text-xs uppercase tracking-[2px] text-[var(--accent)] font-medium">Map</div>
            <div class="font-serif text-xl mt-1">Temecula wineries map</div>
          </a>
          <a href="/guides/best-temecula-wineries" class="rounded-2xl border border-stone-200 bg-white p-5 hover:shadow-md transition">
            <div class="text-xs uppercase tracking-[2px] text-[var(--accent)] font-medium">Best of</div>
            <div class="font-serif text-xl mt-1">Best Temecula wineries</div>
          </a>
          <a href="/guides/first-timer-tasting-route" class="rounded-2xl border border-stone-200 bg-white p-5 hover:shadow-md transition">
            <div class="text-xs uppercase tracking-[2px] text-[var(--accent)] font-medium">Itinerary</div>
            <div class="font-serif text-xl mt-1">First-timer route</div>
          </a>
          <a href="/pairings" class="rounded-2xl border border-stone-200 bg-white p-5 hover:shadow-md transition">
            <div class="text-xs uppercase tracking-[2px] text-[var(--accent)] font-medium">Food</div>
            <div class="font-serif text-xl mt-1">Wine pairing ideas</div>
          </a>
        </div>
      </div>
    </section>

    <!-- Wine Word of the Day -->
    <section class="max-w-4xl mx-auto px-6 py-10">
      <div class="bg-white border border-stone-200 rounded-3xl p-8 md:p-10">
        <div class="flex items-center gap-3 mb-4">
          <div class="text-2xl">🍷</div>
          <div class="uppercase tracking-[2px] text-xs font-medium text-[var(--accent)]">Wine Word of the Day</div>
        </div>
        <h3 class="font-serif text-4xl tracking-tight mb-3">{wordOfTheDay.term}</h3>
        <p class="text-xl text-stone-700 leading-relaxed">{wordOfTheDay.definition}</p>
        <p class="text-xs text-stone-500 mt-6">New word every day • Come back tomorrow</p>
      </div>
    </section>

    <!-- Featured Estates -->
    <section id="explore" class="max-w-6xl mx-auto px-6 py-12">
      <div class="flex justify-between items-baseline mb-10">
        <div>
          <h2 class="text-5xl font-serif tracking-tight">Featured Estates</h2>
          <p class="text-xl text-stone-600 mt-2">Our current recommendations</p>
        </div>
        <a href="/wineries" class="text-[var(--accent)] hover:underline text-lg">See all wineries →</a>
      </div>

      <!-- Search Bar -->
      <div class="mb-8 max-w-md">
        <label for="search-input" class="sr-only">Search featured wineries</label>
        <input
          type="search"
          id="search-input"
          placeholder="Search wineries by name, varietal, pet, or views..."
          autocomplete="off"
          class="w-full px-5 py-3.5 border border-stone-300 rounded-2xl focus:outline-none focus:border-[var(--accent)] text-lg bg-white"
        />
      </div>

      <div id="winery-grid" class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        {featured.map(winery => (
          <a
            href={`/wineries/${winery.slug}`}
            class="winery-card group block rounded-3xl overflow-hidden border border-stone-200 bg-white hover:shadow-xl transition"
            data-search={searchBlob(winery)}
          >
            <div class="h-56 overflow-hidden relative">
              <img 
                src={winery.image} 
                alt={winery.name}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              />
              <span class="absolute top-3 left-3 text-xs font-medium px-3 py-1 rounded-full bg-[#9AAB97] text-[#2B322C] shadow">
                Featured
              </span>
            </div>
            <div class="p-6">
              <div class="flex justify-between items-start mb-3">
                <div>
                  <h3 class="font-serif text-2xl group-hover:text-[var(--accent)] transition leading-tight">{winery.name}</h3>
                  <p class="text-stone-600 mt-0.5">{winery.location} • {winery.price_range}</p>
                </div>
                <div class="text-right">
                  <div class="font-semibold text-xl">{winery.rating}</div>
                  <div class="text-[10px] text-stone-500 -mt-1">rating</div>
                </div>
              </div>

              <div class="flex flex-wrap gap-2 mt-4">
                <span class="text-xs px-3 py-1 bg-[#9AAB97]/25 text-[#4A5E4E] rounded-full font-medium">Featured</span>
                {winery.has_views && (
                  <span class="text-xs px-3 py-1 bg-[#dce4d9] text-[#4A5E4E] rounded-full font-medium">Sip with a View</span>
                )}
                {winery.pet_friendly && (
                  <span class="text-xs px-3 py-1 bg-[#dce4d9] text-[#4A5E4E] rounded-full">Pet Friendly</span>
                )}
                {winery.kid_friendly?.allowed && (
                  <span class="text-xs px-3 py-1 bg-[#eef0e9] text-[#4A5E4E] rounded-full">Kid Friendly</span>
                )}
                <span class="text-xs px-3 py-1 bg-stone-100 text-stone-600 rounded-full">{winery.varietals[0]}</span>
              </div>
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- The Wine Collection -->
    <section class="max-w-6xl mx-auto px-6 py-16 border-t border-stone-200">
      <div class="flex flex-col lg:flex-row lg:justify-between lg:items-end gap-6 mb-10">
        <div class="max-w-2xl">
          <p class="text-xs uppercase tracking-[0.28em] text-[var(--accent)] font-medium mb-3">{collectionIntro.eyebrow}</p>
          <h2 class="text-5xl font-serif tracking-tight">The Wine Collection</h2>
          <p class="text-xl text-stone-600 mt-3 leading-relaxed">
            Pour yourself a glass. Press play. Go somewhere.
          </p>
          <p class="text-stone-600 mt-4 leading-relaxed">
            Movies, series, and documentaries that celebrate vineyards, estates, food, travel, and the pleasure of slowing down —
            then connect back to real Temecula wine country.
          </p>
        </div>
        <a href="/collection" class="text-[var(--accent)] hover:underline text-lg shrink-0">Full cinematic library →</a>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5 mb-8">
        {collectionFeatured.map((t) => (
          <a href="/collection" class="rounded-2xl border border-stone-200 bg-white p-5 hover:shadow-md transition block">
            <div class="flex justify-between text-xs text-stone-500 mb-2">
              <span>{t.yearLabel}</span>
              <span class="font-semibold text-[var(--primary)]">BA {t.wineLifeScore}</span>
            </div>
            <div class="font-serif text-xl text-[var(--ink)]">{t.title}</div>
            {t.region && <div class="text-xs text-stone-500 mt-1">{t.region}</div>}
          </a>
        ))}
      </div>
      <a href="/collection" class="inline-flex items-center px-6 py-3 rounded-full bg-[var(--primary)] text-white text-sm font-medium hover:opacity-90 transition">
        Browse The Wine Collection →
      </a>
    </section>

    <!-- Guides -->
    <section class="max-w-6xl mx-auto px-6 py-16 border-t border-stone-200">
      <div class="flex justify-between items-baseline mb-10">
        <div>
          <h2 class="text-5xl font-serif tracking-tight">Trip Guides</h2>
          <p class="text-xl text-stone-600 mt-2">Practical planning, not window dressing</p>
        </div>
        <a href="/guides" class="text-[var(--accent)] hover:underline text-lg">All guides →</a>
      </div>
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        <a href="/pairings" class="group block rounded-3xl border border-stone-200 bg-white p-8 hover:shadow-xl transition">
          <div class="text-xs uppercase tracking-[2px] text-[var(--accent)] font-medium mb-3">Pairings</div>
          <h3 class="font-serif text-3xl group-hover:text-[var(--accent)] transition">Wine Pairing Suggestions</h3>
          <p class="text-stone-600 mt-4 leading-relaxed">Food matches by wine type, protein, occasion, and season — with Temecula winery examples.</p>
          <div class="mt-6 text-[var(--accent)] font-medium">Browse pairings →</div>
        </a>
        <a href="/guides/first-timer-tasting-route" class="group block rounded-3xl border border-stone-200 bg-white p-8 hover:shadow-xl transition">
          <div class="text-xs uppercase tracking-[2px] text-[var(--accent)] font-medium mb-3">Planning</div>
          <h3 class="font-serif text-3xl group-hover:text-[var(--accent)] transition">First-Timer Tasting Route</h3>
          <p class="text-stone-600 mt-4 leading-relaxed">A realistic three-stop day on the Rancho California spine — timing, food, transport, and mistakes to skip.</p>
          <div class="mt-6 text-[var(--accent)] font-medium">Read guide →</div>
        </a>
        <a href="/guides/best-temecula-wineries" class="group block rounded-3xl border border-stone-200 bg-white p-8 hover:shadow-xl transition">
          <div class="text-xs uppercase tracking-[2px] text-[var(--accent)] font-medium mb-3">Best of</div>
          <h3 class="font-serif text-3xl group-hover:text-[var(--accent)] transition">Best Temecula Wineries</h3>
          <p class="text-stone-600 mt-4 leading-relaxed">Top-rated picks and how to choose the best Temecula winery stop for your day — from our full directory list.</p>
          <div class="mt-6 text-[var(--accent)] font-medium">Read guide →</div>
        </a>
        <a href="/guides/pet-friendly-wineries" class="group block rounded-3xl border border-stone-200 bg-white p-8 hover:shadow-xl transition">
          <div class="text-xs uppercase tracking-[2px] text-[var(--accent)] font-medium mb-3">Pets</div>
          <h3 class="font-serif text-3xl group-hover:text-[var(--accent)] transition">Pet-Friendly Wineries</h3>
          <p class="text-stone-600 mt-4 leading-relaxed">Which estates welcome dogs, outdoor patio rules, packing list, and resorts that are typically no-pet.</p>
          <div class="mt-6 text-[var(--accent)] font-medium">Read guide →</div>
        </a>
        <a href="/guides/sip-with-a-view" class="group block rounded-3xl border border-stone-200 bg-white p-8 hover:shadow-xl transition">
          <div class="text-xs uppercase tracking-[2px] text-[var(--accent)] font-medium mb-3">Scenic</div>
          <h3 class="font-serif text-3xl group-hover:text-[var(--accent)] transition">Sip with a View</h3>
          <p class="text-stone-600 mt-4 leading-relaxed">Temecula wineries with valley, hilltop, vineyard, and lake views — plus how to search them in the directory.</p>
          <div class="mt-6 text-[var(--accent)] font-medium">Read guide →</div>
        </a>
        <a href="/collection" class="group block rounded-3xl border border-stone-200 bg-white p-8 hover:shadow-xl transition">
          <div class="text-xs uppercase tracking-[2px] text-[var(--accent)] font-medium mb-3">Entertainment</div>
          <h3 class="font-serif text-3xl group-hover:text-[var(--accent)] transition">The Wine Collection</h3>
          <p class="text-stone-600 mt-4 leading-relaxed">Cinematic wine list — films, series, and documentaries that inspire estates, hospitality, and the wine life.</p>
          <div class="mt-6 text-[var(--accent)] font-medium">Browse collection →</div>
        </a>
      </div>
    </section>

    <!-- Hot Air Balloon Rides -->
    <section id="balloons" class="max-w-6xl mx-auto px-6 py-16 border-t border-stone-200">
      <div class="flex justify-between items-baseline mb-10">
        <div>
          <h2 class="text-5xl font-serif tracking-tight">Hot Air Balloon Rides</h2>
          <p class="text-xl text-stone-600 mt-2">Float above the vineyards at sunrise</p>
        </div>
        <a href="/balloons" class="text-[var(--accent)] hover:underline text-lg">See all operators →</a>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        {featuredBalloons.map((b) => (
          <a href={`/balloons/${b.slug}`} class="group block rounded-3xl overflow-hidden border border-stone-200 bg-white hover:shadow-xl transition">
            <div class="h-56 overflow-hidden">
              <img
                src={b.image}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                alt={`Hot air balloon — ${b.name}`}
                loading="lazy"
              />
            </div>
            <div class="p-6">
              <h3 class="font-serif text-2xl group-hover:text-[var(--accent)] transition">{b.name}</h3>
              <p class="text-stone-600 mt-1">{b.tagline}</p>
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- Moving to Temecula — soft RE referral -->
    <section class="max-w-6xl mx-auto px-6 py-10">
      <RelocateCta variant="banner" />
    </section>

    <!-- Free Wine Day Planner PDF -->
    <section class="max-w-6xl mx-auto px-6 py-12 border-t border-stone-200">
      <div class="rounded-3xl border border-stone-200 bg-[#faf7f2] p-8 sm:p-10 flex flex-col md:flex-row md:items-center md:justify-between gap-6">
        <div>
          <div class="text-sm uppercase tracking-[2px] text-[var(--accent)] mb-2">Free printable</div>
          <h2 class="font-serif text-3xl sm:text-4xl tracking-tight text-stone-900">Wine Day Planner — free PDF</h2>
          <p class="text-stone-600 mt-3 max-w-xl">Day 1 and Day 2 Temecula corridor routes with named estates, sip-and-spit pacing, and a field checklist. Optional tip if it helps your trip.</p>
        </div>
        <div class="flex flex-col sm:flex-row gap-3 shrink-0">
          <a
            href="/wine-day-planner/"
            class="inline-flex items-center justify-center px-8 py-4 bg-[var(--primary)] text-white hover:opacity-90 rounded-full font-medium transition whitespace-nowrap"
          >
            Free download →
          </a>
        </div>
      </div>
    </section>

    <!-- Winery advertising -->
    <section class="max-w-6xl mx-auto px-6 py-16 border-t border-stone-200">
      <div class="rounded-3xl bg-[var(--primary)] text-white p-8 sm:p-10 flex flex-col md:flex-row md:items-center md:justify-between gap-6">
        <div>
          <div class="text-sm uppercase tracking-[2px] text-white/70 mb-2">For wineries</div>
          <h2 class="font-serif text-3xl sm:text-4xl tracking-tight">Featured Listing — $49 / 30 days</h2>
          <p class="text-white/80 mt-3 max-w-xl">Highlighted placement on this independent Temecula wine directory. Secure checkout via Stripe.</p>
        </div>
        <a
          href="/advertise"
          class="inline-flex items-center justify-center px-8 py-4 bg-white text-[var(--primary)] hover:bg-stone-100 rounded-full font-medium transition whitespace-nowrap"
        >
          Advertise with us →
        </a>
      </div>
    </section>
  </main>

  <script>
    const input = document.getElementById('search-input') as HTMLInputElement | null;
    const cards = Array.from(document.querySelectorAll<HTMLElement>('#winery-grid .winery-card'));

    function filterWineries() {
      if (!input) return;
      const q = input.value.trim().toLowerCase();
      for (const card of cards) {
        const hay = card.dataset.search || card.textContent?.toLowerCase() || '';
        card.classList.toggle('hidden', !!(q && !hay.includes(q)));
      }
    }

    input?.addEventListener('input', filterWineries);
    input?.addEventListener('search', filterWineries);
  </script>
</Layout>
