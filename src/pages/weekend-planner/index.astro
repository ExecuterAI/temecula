---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
---

<Layout
  title="Wine Day Planner moved"
  description="The Temecula Wine Day Planner is free at /wine-day-planner."
  noindex={true}
>
  <Navbar />
  <main class="max-w-2xl mx-auto px-6 py-20 text-center">
    <h1 class="text-4xl font-serif mb-4">Moved</h1>
    <p class="text-stone-600 mb-8">
      The planner is free and lives at the Wine Day Planner page.
    </p>
    <a
      href="/wine-day-planner/"
      class="inline-flex items-center justify-center px-8 py-4 bg-[var(--primary)] text-white rounded-full font-medium"
    >
      Go to free Wine Day Planner →
    </a>
    <meta http-equiv="refresh" content="0;url=/wine-day-planner/" />
  </main>
</Layout>
