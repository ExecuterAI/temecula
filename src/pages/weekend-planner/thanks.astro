---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
---

<!-- Fallback if redirects not applied; meta refresh to free page -->
<Layout title="Redirecting…" description="Wine Day Planner is free." noindex={true}>
  <Navbar />
  <main class="max-w-xl mx-auto px-6 py-20 text-center">
    <p class="text-stone-600 mb-6">Taking you to the free Wine Day Planner…</p>
    <a href="/wine-day-planner/" class="text-[var(--accent)] underline">Continue →</a>
  </main>
  <meta http-equiv="refresh" content="0;url=/wine-day-planner/" />
</Layout>
