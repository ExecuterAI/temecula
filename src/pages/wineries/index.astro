---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import wineries from '../../data/wineries.json';

const searchBlob = (w: (typeof wineries)[number]) => {
  const bits = [
    w.name,
    w.location,
    w.price_range,
    ...(w.varietals || []),
    w.pet_friendly ? 'pet friendly dogs' : '',
    w.kid_friendly?.allowed ? 'kid friendly family children' : '',
    w.slug,
  ];
  return bits.filter(Boolean).join(' ').toLowerCase();
};
---

<Layout title="All Wineries">
  <Navbar />

  <main class="max-w-6xl mx-auto px-6 py-12">
    <div class="flex justify-between items-end mb-10">
      <div>
        <h1 class="text-6xl font-serif tracking-tight">All Wineries</h1>
        <p class="text-xl text-stone-600 mt-2">Explore {wineries.length} wineries in Temecula Valley</p>
      </div>
      <a href="/" class="text-[var(--accent)] hover:underline">← Back to home</a>
    </div>

    <!-- Search -->
    <div class="mb-8 max-w-md">
      <label for="search-input" class="sr-only">Search wineries</label>
      <input
        type="search"
        id="search-input"
        placeholder="Search by name, varietals, or features…"
        autocomplete="off"
        class="w-full px-5 py-3.5 border border-stone-300 rounded-2xl focus:outline-none focus:border-[var(--accent)] text-lg bg-white"
      />
      <p id="search-status" class="text-sm text-stone-500 mt-3 hidden" aria-live="polite"></p>
    </div>

    <div id="winery-grid" class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
      {wineries.map(winery => (
        <a
          href={`/wineries/${winery.slug}`}
          class="winery-card group block rounded-3xl overflow-hidden border border-stone-200 bg-white hover:shadow-xl transition"
          data-search={searchBlob(winery)}
        >
          <div class="h-56 overflow-hidden">
            <img
              src={winery.image}
              alt={winery.name}
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              loading="lazy"
            />
          </div>
          <div class="p-6">
            <div class="flex justify-between items-start mb-3">
              <div>
                <h3 class="font-serif text-2xl group-hover:text-[var(--accent)] transition leading-tight">{winery.name}</h3>
                <p class="text-stone-600 mt-0.5">{winery.location} • {winery.price_range}</p>
              </div>
              <div class="text-right">
                <div class="font-semibold text-xl">{winery.rating}</div>
              </div>
            </div>

            <div class="flex flex-wrap gap-2 mt-4">
              {winery.pet_friendly && (
                <span class="text-xs px-3 py-1 bg-emerald-100 text-emerald-700 rounded-full">Pet Friendly</span>
              )}
              {winery.kid_friendly?.allowed && (
                <span class="text-xs px-3 py-1 bg-amber-100 text-amber-700 rounded-full">Kid Friendly</span>
              )}
              <span class="text-xs px-3 py-1 bg-stone-100 text-stone-600 rounded-full">{winery.varietals[0]}</span>
            </div>
          </div>
        </a>
      ))}
    </div>
  </main>

  <script>
    const input = document.getElementById('search-input') as HTMLInputElement | null;
    const status = document.getElementById('search-status');
    const cards = Array.from(document.querySelectorAll<HTMLElement>('#winery-grid .winery-card'));

    function filterWineries() {
      if (!input) return;
      const q = input.value.trim().toLowerCase();
      let visible = 0;

      for (const card of cards) {
        const hay = card.dataset.search || card.textContent?.toLowerCase() || '';
        const show = !q || hay.includes(q);
        card.classList.toggle('hidden', !show);
        if (show) visible += 1;
      }

      if (status) {
        if (!q) {
          status.classList.add('hidden');
          status.textContent = '';
        } else {
          status.classList.remove('hidden');
          status.textContent =
            visible === 0
              ? `No wineries match “${input.value.trim()}”.`
              : `${visible} winery${visible === 1 ? '' : 'ies'} match “${input.value.trim()}”.`;
        }
      }
    }

    input?.addEventListener('input', filterWineries);
    input?.addEventListener('search', filterWineries);
  </script>
</Layout>
