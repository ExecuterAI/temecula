---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import wineries from '../../data/wineries.json';

// Paid Featured listings first, then name
const sorted = [...wineries].sort((a, b) => {
  if (!!b.featured !== !!a.featured) return (b.featured ? 1 : 0) - (a.featured ? 1 : 0);
  return a.name.localeCompare(b.name);
});

const searchBlob = (w: (typeof wineries)[number]) => {
  const bits = [
    w.name,
    w.location,
    w.price_range,
    ...(w.varietals || []),
    w.pet_friendly ? 'pet friendly dogs' : '',
    w.kid_friendly?.allowed ? 'kid friendly family children' : '',
    w.featured ? 'featured' : '',
    w.has_views
      ? [
          'view views scenic overlook panoramic vista',
          'sip with a view',
          'tasting with a view',
          'drink in the views',
          'wineries with a view',
          w.view_level || '',
          w.view_notes || '',
          ...(w.view_tags || []),
        ].join(' ')
      : '',
    w.slug,
  ];
  return bits.filter(Boolean).join(' ').toLowerCase();
};

const itemListJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Temecula Wineries Directory & List',
  description: `Complete list of ${wineries.length} Temecula Valley wineries for tasting-room trip planning.`,
  numberOfItems: wineries.length,
  itemListElement: sorted.slice(0, 40).map((w, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: w.name,
    url: `https://bellieacreswine.com/wineries/${w.slug}/`,
  })),
};

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'How many Temecula wineries are in this directory?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: `This Temecula wine directory currently lists ${wineries.length} estates with practical trip details such as location, varietals, pet and family notes, and links to official sites.`,
      },
    },
    {
      '@type': 'Question',
      name: 'What is the best Temecula winery for a first visit?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'There is no single best Temecula winery for everyone. First-timers often prefer estates with clear tasting options, pleasant outdoor space, and flexible pacing. Start with our best Temecula wineries guide and first-timer tasting route, then confirm hours and reservations on the winery website.',
      },
    },
    {
      '@type': 'Question',
      name: 'Is this the official Temecula Valley winery association site?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'No. Bellie Acres Wine is an independent Temecula wineries list and trip-planning directory. Always verify fees, hours, and policies with each winery before you go.',
      },
    },
  ],
};
---

<Layout
  title="Temecula Wineries Directory & List"
  description={`Complete Temecula wineries list and directory — ${wineries.length} Temecula Valley tasting rooms with ratings, varietals, pet/family notes, and links. Plan Temecula wine stops in one place.`}
  jsonLd={[itemListJsonLd, faqJsonLd]}
>
  <Navbar />

  <main class="max-w-6xl mx-auto px-6 py-12">
    <div class="flex flex-col lg:flex-row lg:justify-between lg:items-end gap-6 mb-8">
      <div class="max-w-3xl">
        <p class="text-sm uppercase tracking-[2px] text-[var(--accent)] font-medium mb-3">Temecula Valley · Independent guide</p>
        <h1 class="text-4xl sm:text-5xl md:text-6xl font-serif tracking-tight">
          Temecula Wineries Directory &amp; List
        </h1>
        <p class="text-xl text-stone-600 mt-4 leading-relaxed">
          Browse the full <strong>Temecula wineries list</strong> — {wineries.length} estates in this
          <strong> Temecula wine directory</strong>. Search by name, varietal, or features, then open any listing for tasting context and planning notes.
        </p>
      </div>
      <a href="/" class="text-[var(--accent)] hover:underline shrink-0">← Back to home</a>
    </div>

    <section class="mb-12 max-w-3xl space-y-5 text-stone-700 leading-relaxed">
      <h2 class="font-serif text-3xl tracking-tight text-stone-900">How to use this Temecula wineries directory</h2>
      <p>
        Temecula Valley is a warm-climate Southern California AVA where tasting rooms cluster mainly along
        <strong>Rancho California Road</strong>, with important side corridors on <strong>De Portola Road</strong>,
        <strong>Calle Contento</strong>, and nearby lanes. That geography matters more than a random “top 10” poster:
        the best day is almost always a <em>clustered</em> day — two or three estates close together — not a scavenger
        hunt across the entire valley.
      </p>
      <p>
        This hub is the master index for trip planning. Cards below are intentionally scannable (rating, price feel,
        pet/family/view tags), while each winery profile carries original written context: atmosphere, corridor cues,
        varietal focus, and visit pacing. Use search for “pet”, “Cabernet”, “sparkling”, or “sip with a view”, then
        open profiles before you book.
      </p>
      <p>
        <strong>Microclimate, in plain language:</strong> Temecula sits inland enough for warm afternoons and cool
        evening pull-downs that help grapes hang for ripe reds and approachable whites. Summer patio heat is real;
        spring and fall are the sweet spot for outdoor flights. Weekday late mornings are calmer than Saturday
        1–4 p.m. If you only remember one rule: <strong>reserve weekends</strong>, designate a driver, and leave
        white space between pours.
      </p>
      <p>
        First visit? Pair this list with our
        <a class="text-[var(--accent)] underline" href="/guides/first-timer-tasting-route">first-timer tasting route</a>,
        <a class="text-[var(--accent)] underline" href="/guides/best-temecula-wineries">best Temecula wineries</a> shortlist,
        <a class="text-[var(--accent)] underline" href="/map">interactive map</a>,
        <a class="text-[var(--accent)] underline" href="/guides/weekend-in-temecula-wine-country">weekend wine-country plan</a>,
        and
        <a class="text-[var(--accent)] underline" href="/guides/weekday-vs-weekend-tasting">weekday vs weekend tasting guide</a>.
        Red drinkers can go deeper with
        <a class="text-[var(--accent)] underline" href="/guides/temecula-red-varietals">Temecula red varietals</a>.
      </p>
    </section>

    <div class="mb-10 grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
      <a href="/guides/best-temecula-wineries" class="rounded-2xl border border-stone-200 bg-white p-5 hover:shadow-md transition">
        <div class="text-xs uppercase tracking-[2px] text-[var(--accent)] font-medium">Curated</div>
        <div class="font-serif text-xl mt-1">Best Temecula wineries</div>
        <p class="text-sm text-stone-600 mt-2">Top-rated and first-visit friendly picks from the directory.</p>
      </a>
      <a href="/map" class="rounded-2xl border border-stone-200 bg-white p-5 hover:shadow-md transition">
        <div class="text-xs uppercase tracking-[2px] text-[var(--accent)] font-medium">Map</div>
        <div class="font-serif text-xl mt-1">Temecula wineries map</div>
        <p class="text-sm text-stone-600 mt-2">Interactive map of Temecula wineries — pins, addresses, and route planning.</p>
      </a>
      <a href="/guides/pet-friendly-wineries" class="rounded-2xl border border-stone-200 bg-white p-5 hover:shadow-md transition">
        <div class="text-xs uppercase tracking-[2px] text-[var(--accent)] font-medium">Filter vibe</div>
        <div class="font-serif text-xl mt-1">Pet-friendly list</div>
        <p class="text-sm text-stone-600 mt-2">Dog-welcome estates and patio rules for wine country with pets.</p>
      </a>
      <a href="/guides/sip-with-a-view" class="rounded-2xl border border-stone-200 bg-white p-5 hover:shadow-md transition">
        <div class="text-xs uppercase tracking-[2px] text-[var(--accent)] font-medium">Scenic</div>
        <div class="font-serif text-xl mt-1">Sip with a View</div>
        <p class="text-sm text-stone-600 mt-2">Valley, hilltop, vineyard, and lake overlooks — searchable below.</p>
      </a>
    </div>

    <!-- Search -->
    <div class="mb-8 max-w-md">
      <label for="search-input" class="sr-only">Search Temecula wineries</label>
      <input
        type="search"
        id="search-input"
        placeholder="Search name, varietal, pet, or views (sip with a view)…"
        autocomplete="off"
        class="w-full px-5 py-3.5 border border-stone-300 rounded-2xl focus:outline-none focus:border-[var(--accent)] text-lg bg-white"
      />
      <p id="search-status" class="text-sm text-stone-500 mt-3 hidden" aria-live="polite"></p>
    </div>

    <div id="winery-grid" class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
      {sorted.map(winery => (
        <a
          href={`/wineries/${winery.slug}`}
          class:list={[
            'winery-card group block rounded-3xl overflow-hidden border bg-white hover:shadow-xl transition',
            winery.featured ? 'border-[#9AAB97] ring-1 ring-[#9AAB97]/50' : 'border-stone-200',
          ]}
          data-search={searchBlob(winery)}
        >
          <div class="h-56 overflow-hidden relative">
            <img
              src={winery.image}
              alt={`${winery.name} — Temecula winery`}
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              loading="lazy"
            />
            {winery.featured && (
              <span class="absolute top-3 left-3 text-xs font-medium px-3 py-1 rounded-full bg-[#9AAB97] text-[#2B322C] shadow">
                Featured
              </span>
            )}
          </div>
          <div class="p-6">
            <div class="flex justify-between items-start mb-3">
              <div>
                <h2 class="font-serif text-2xl group-hover:text-[var(--accent)] transition leading-tight">{winery.name}</h2>
                <p class="text-stone-600 mt-0.5">{winery.location} • {winery.price_range}</p>
              </div>
              <div class="text-right">
                <div class="font-semibold text-xl">{winery.rating}</div>
              </div>
            </div>

            <div class="flex flex-wrap gap-2 mt-4">
              {winery.featured && (
                <span class="text-xs px-3 py-1 bg-[#9AAB97]/25 text-[#4A5E4E] rounded-full font-medium">Featured</span>
              )}
              {winery.has_views && (
                <span class="text-xs px-3 py-1 bg-[#dce4d9] text-[#4A5E4E] rounded-full font-medium">Sip with a View</span>
              )}
              {winery.pet_friendly && (
                <span class="text-xs px-3 py-1 bg-[#dce4d9] text-[#4A5E4E] rounded-full">Pet Friendly</span>
              )}
              {winery.kid_friendly?.allowed && (
                <span class="text-xs px-3 py-1 bg-[#eef0e9] text-[#4A5E4E] rounded-full">Kid Friendly</span>
              )}
              <span class="text-xs px-3 py-1 bg-stone-100 text-stone-600 rounded-full">{winery.varietals[0]}</span>
            </div>
          </div>
        </a>
      ))}
    </div>

    <!-- Editorial outro: route planning prose for crawlers + humans -->
    <section class="mt-20 max-w-3xl border-t border-stone-200 pt-12 space-y-5 text-stone-700 leading-relaxed">
      <h2 class="font-serif text-3xl tracking-tight text-stone-900">Building a tasting route from this list</h2>
      <p>
        Start with a purpose: anniversary sparkling, Rhône-style reds, dog-friendly patios, or hilltop views.
        Shortlist three estates maximum for a first day. Plot them on the
        <a class="text-[var(--accent)] underline" href="/map">Temecula wineries map</a> and reject any stop that
        forces a long backtrack. On Rancho California Road, expect more traffic and resort energy; on De Portola,
        expect a quieter east-valley pace; on Calle Contento, think boutique hillside hops.
      </p>
      <p>
        <strong>Weekday vs weekend:</strong> Fridays after lunch and all day Saturday are the crush periods for
        popular patios. If your group hates lines, book seated tastings or shift to Tuesday–Thursday. Live music
        can be wonderful and also loud — check estate calendars if you want conversation-level tasting.
        More detail lives in our
        <a class="text-[var(--accent)] underline" href="/guides/weekday-vs-weekend-tasting">weekday vs weekend guide</a>.
      </p>
      <p>
        <strong>First-timer tips:</strong> Eat real food before pour one. Share flights if you are driving later.
        Spit or dump without embarrassment — staff prefer safe guests to heroes. Buy the bottle you loved instead
        of collecting stamps. If you want a full multi-day template, use
        <a class="text-[var(--accent)] underline" href="/guides/weekend-in-temecula-wine-country">How to spend a weekend in Temecula wine country</a>.
      </p>
      <p>
        Every profile in this directory includes original planning prose plus links to official websites. Policies,
        fees, and hours change; Bellie Acres Wine does not take tasting reservations and is not a winery or alcohol retailer.
      </p>
    </section>

    <!-- FAQ / keyword support (human-readable) -->
    <section class="mt-16 max-w-3xl border-t border-stone-200 pt-12">
      <h2 class="font-serif text-3xl tracking-tight mb-6">Temecula wine directory FAQs</h2>
      <div class="space-y-6 text-stone-700 leading-relaxed">
        <div>
          <h3 class="font-semibold text-stone-900 text-lg">Is this a full Temecula wineries list?</h3>
          <p class="mt-2">
            Yes — this page is our living <strong>Temecula wineries list</strong> and directory index. Listings focus on visitor planning details and link out to each estate’s official site for reservations, fees, and live hours.
          </p>
        </div>
        <div>
          <h3 class="font-semibold text-stone-900 text-lg">How do I find the best Temecula winery for me?</h3>
          <p class="mt-2">
            “Best” depends on whether you want sparkling, bold reds, a quiet patio, kids, or dogs. Use search above, then compare our
            <a class="text-[var(--accent)] underline" href="/guides/best-temecula-wineries">best Temecula wineries</a> guide and
            <a class="text-[var(--accent)] underline" href="/guides/first-timer-tasting-route">first-timer route</a>.
          </p>
        </div>
        <div>
          <h3 class="font-semibold text-stone-900 text-lg">Do you sell Temecula wine online?</h3>
          <p class="mt-2">
            No. Bellie Acres Wine is an independent guide only. We help you discover Temecula wine country; purchases and tastings happen directly with each winery.
          </p>
        </div>
        <div>
          <h3 class="font-semibold text-stone-900 text-lg">How many stops should I book in one day?</h3>
          <p class="mt-2">
            Two excellent visits beat five rushed ones. Add a third only if drives stay short and someone is a dedicated driver or you are on a shuttle. See the
            <a class="text-[var(--accent)] underline" href="/guides/weekend-in-temecula-wine-country">weekend itinerary guide</a> for multi-day pacing.
          </p>
        </div>
      </div>
    </section>
  </main>

  <script>
    const input = document.getElementById('search-input') as HTMLInputElement | null;
    const status = document.getElementById('search-status');
    const cards = Array.from(document.querySelectorAll<HTMLElement>('#winery-grid .winery-card'));

    function filterWineries() {
      if (!input) return;
      const q = input.value.trim().toLowerCase();
      let visible = 0;

      for (const card of cards) {
        const hay = card.dataset.search || card.textContent?.toLowerCase() || '';
        const show = !q || hay.includes(q);
        card.classList.toggle('hidden', !show);
        if (show) visible += 1;
      }

      if (status) {
        if (!q) {
          status.classList.add('hidden');
          status.textContent = '';
        } else {
          status.classList.remove('hidden');
          status.textContent =
            visible === 0
              ? `No wineries match “${input.value.trim()}”.`
              : `${visible} ${visible === 1 ? 'winery matches' : 'wineries match'} “${input.value.trim()}”.`;
        }
      }
    }

    // Support ?q= from WebSite SearchAction
    const params = new URLSearchParams(window.location.search);
    const qParam = params.get('q');
    if (qParam && input) {
      input.value = qParam;
      filterWineries();
    }

    input?.addEventListener('input', filterWineries);
    input?.addEventListener('search', filterWineries);
  </script>
</Layout>
