---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import data from '../../data/pairings.json';

const { categories, pairings } = data;
const featured = [
  'cabernet-sauvignon-pairings',
  'steak-wine-pairings',
  'date-night-pairings',
  'summer-wine-pairings',
].map((slug) => pairings.find((p) => p.slug === slug)).filter(Boolean);
---

<Layout
  title="Temecula Wine Pairing Suggestions"
  description="Wine pairing ideas for Temecula Valley — by wine type, protein, occasion, and season. Friendly food matches tied to local wineries on Bellie Acres Wine."
>
  <Navbar />
  <main class="max-w-6xl mx-auto px-6 py-16">
    <div class="max-w-3xl">
      <div class="text-xs uppercase tracking-[2px] text-[var(--accent)] font-medium mb-3">Eat & Drink</div>
      <h1 class="text-5xl md:text-6xl font-serif tracking-tight mb-5">Wine Pairing Suggestions</h1>
      <p class="text-xl text-stone-600 leading-relaxed">
        Practical food-and-wine ideas for Temecula Valley tasting days and home dinners. Start with the wine style,
        the main ingredient, the occasion, or the season — then browse wineries in our directory that pour a good example.
      </p>
      <p class="mt-4 text-stone-600 leading-relaxed">
        These are friendly guidelines, not rigid rules. If you love Cabernet with salmon, you’re still allowed at the table.
      </p>
    </div>

    <!-- Category nav -->
    <section class="mt-14">
      <h2 class="text-3xl font-serif tracking-tight mb-6">Browse pairings</h2>
      <div class="grid md:grid-cols-2 gap-6">
        {categories.map((cat) => {
          const count = pairings.filter((p) => p.category === cat.slug).length;
          return (
            <a
              href={`/pairings/${cat.slug}`}
              class="group block rounded-3xl border border-stone-200 bg-white p-8 hover:shadow-xl transition"
            >
              <div class="text-xs uppercase tracking-[2px] text-[var(--accent)] font-medium mb-3">
                {count} guides
              </div>
              <h3 class="font-serif text-3xl group-hover:text-[var(--accent)] transition">{cat.title}</h3>
              <p class="text-stone-600 mt-4 leading-relaxed">{cat.description}</p>
              <div class="mt-6 text-[var(--accent)] font-medium">Explore {cat.navLabel.toLowerCase()} →</div>
            </a>
          );
        })}
      </div>
    </section>

    <!-- Featured -->
    <section class="mt-16">
      <div class="flex justify-between items-baseline mb-6">
        <h2 class="text-3xl font-serif tracking-tight">Popular starting points</h2>
      </div>
      <div class="grid md:grid-cols-2 gap-6">
        {featured.map((p) => (
          <a
            href={`/pairings/guide/${p.slug}`}
            class="group block rounded-3xl border border-stone-200 bg-white p-7 hover:shadow-xl transition"
          >
            <div class="text-xs uppercase tracking-[2px] text-stone-500 font-medium mb-2">{p.wineStyle}</div>
            <h3 class="font-serif text-2xl group-hover:text-[var(--accent)] transition">{p.title}</h3>
            <p class="text-stone-600 mt-3 leading-relaxed line-clamp-3">{p.summary}</p>
            <div class="mt-5 text-[var(--accent)] font-medium">Read pairing →</div>
          </a>
        ))}
      </div>
    </section>

    <!-- How to use -->
    <section class="mt-16 bg-white border border-stone-200 rounded-3xl p-8 md:p-10">
      <h2 class="font-serif text-3xl mb-4">How to use this guide</h2>
      <ul class="space-y-3 text-stone-700 leading-relaxed list-disc pl-6">
        <li>Planning dinner after a tasting day? Start with <a class="text-[var(--accent)] hover:underline" href="/pairings/by-protein">protein & ingredient</a>.</li>
        <li>Already bought a bottle? Start with <a class="text-[var(--accent)] hover:underline" href="/pairings/by-wine">wine type</a>.</li>
        <li>Heading to live music or a picnic? Try <a class="text-[var(--accent)] hover:underline" href="/pairings/by-occasion">occasions</a>.</li>
        <li>Want winery ideas that match the style? Each guide links to estates in our <a class="text-[var(--accent)] hover:underline" href="/wineries">Temecula directory</a>.</li>
      </ul>
      <p class="mt-6 text-sm text-stone-500">
        Independent suggestions for trip planning and home entertaining. Always confirm current wine lists and menus with each winery.
      </p>
    </section>
  </main>
</Layout>
