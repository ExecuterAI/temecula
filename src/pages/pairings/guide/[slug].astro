---
import Layout from '../../../layouts/Layout.astro';
import Navbar from '../../../components/Navbar.astro';
import data from '../../../data/pairings.json';
import wineries from '../../../data/wineries.json';

export function getStaticPaths() {
  return data.pairings.map((pairing) => ({
    params: { slug: pairing.slug },
    props: { pairing },
  }));
}

const { pairing } = Astro.props;
const category = data.categories.find((c) => c.slug === pairing.category);
const related = data.pairings
  .filter((p) => p.category === pairing.category && p.slug !== pairing.slug)
  .slice(0, 3);
const examples = (pairing.winerySlugs || [])
  .map((s) => wineries.find((w) => w.slug === s))
  .filter(Boolean);
---

<Layout
  title={`${pairing.title} | Temecula Wine Pairings`}
  description={pairing.seoBlurb || pairing.summary}
>
  <Navbar />
  <main class="max-w-4xl mx-auto px-6 py-16">
    <div class="flex flex-wrap gap-3 text-sm text-stone-500 mb-6">
      <a href="/pairings" class="hover:text-[var(--accent)]">Wine Pairings</a>
      <span>/</span>
      {category && (
        <a href={`/pairings/${category.slug}`} class="hover:text-[var(--accent)]">{category.title}</a>
      )}
    </div>

    <div class="text-xs uppercase tracking-[2px] text-[var(--accent)] font-medium mb-3">{pairing.wineStyle}</div>
    <h1 class="text-5xl md:text-6xl font-serif tracking-tight mb-6">{pairing.title}</h1>
    <p class="text-xl text-stone-600 leading-relaxed">{pairing.summary}</p>

    <section class="mt-12 grid md:grid-cols-2 gap-8">
      <div class="rounded-3xl border border-stone-200 bg-white p-8">
        <h2 class="font-serif text-2xl mb-4">Recommended food matches</h2>
        <ul class="space-y-3 text-stone-700 text-lg">
          {pairing.foods.map((f) => (
            <li class="flex gap-3"><span class="text-[var(--accent)] mt-1">✓</span><span>{f}</span></li>
          ))}
        </ul>
      </div>
      <div class="rounded-3xl border border-stone-200 bg-white p-8">
        <h2 class="font-serif text-2xl mb-4">Why it works</h2>
        <p class="text-stone-700 leading-relaxed text-lg">{pairing.why}</p>
      </div>
    </section>

    {examples.length > 0 && (
      <section class="mt-12">
        <h2 class="font-serif text-3xl mb-3">Temecula wineries to try for this style</h2>
        <p class="text-stone-600 mb-6 max-w-2xl">
          These directory listings often highlight this style among their strengths. Confirm the current tasting list before you go.
        </p>
        <div class="grid sm:grid-cols-2 gap-5">
          {examples.map((w) => (
            <a
              href={`/wineries/${w.slug}`}
              class="group block rounded-3xl border border-stone-200 bg-white p-6 hover:shadow-xl transition"
            >
              <h3 class="font-serif text-2xl group-hover:text-[var(--accent)] transition">{w.name}</h3>
              <p class="text-stone-600 mt-2">{w.location} • {w.price_range} • {w.rating}/5</p>
              <p class="text-sm text-stone-500 mt-3 line-clamp-2">{(w.varietals || []).join(' · ')}</p>
              <div class="mt-4 text-[var(--accent)] font-medium">View winery →</div>
            </a>
          ))}
        </div>
      </section>
    )}

    <section class="mt-12 rounded-3xl bg-stone-900 text-stone-200 p-8 md:p-10">
      <h2 class="font-serif text-2xl text-white mb-3">A simple tasting-day tip</h2>
      <p class="leading-relaxed">
        If you’re visiting multiple Temecula tasting rooms, eat a real snack before heavier reds and keep water handy.
        Pairing ideas work best when you’re not tasting on an empty stomach. Please drink responsibly and designate a driver.
      </p>
      <div class="mt-6 flex flex-wrap gap-4">
        <a href="/wineries" class="px-5 py-2.5 rounded-full bg-white text-stone-900 font-medium hover:bg-white/90 transition">Browse wineries</a>
        <a href="/pairings" class="px-5 py-2.5 rounded-full border border-white/30 text-white font-medium hover:bg-white/10 transition">More pairings</a>
      </div>
    </section>

    {related.length > 0 && (
      <section class="mt-14">
        <h2 class="font-serif text-3xl mb-6">Related pairings</h2>
        <div class="grid md:grid-cols-3 gap-5">
          {related.map((p) => (
            <a href={`/pairings/guide/${p.slug}`} class="block rounded-3xl border border-stone-200 bg-white p-6 hover:shadow-xl transition group">
              <h3 class="font-serif text-xl group-hover:text-[var(--accent)] transition">{p.title}</h3>
              <p class="text-sm text-stone-600 mt-3 line-clamp-3">{p.summary}</p>
            </a>
          ))}
        </div>
      </section>
    )}
  </main>
</Layout>
