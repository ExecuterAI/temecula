---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import events from '../data/curated-events.json';
---

<Layout
  title="Temecula Wine Country Events"
  description="Upcoming Temecula community and wine-country events, including the Wine Country Run on November 8, 2026. Confirm dates with organizers. Independent notes from Bellie Acres Wine."
>
  <Navbar />
  <main class="max-w-5xl mx-auto px-6 py-16">
    <h1 class="text-5xl sm:text-6xl font-serif tracking-tight mb-3">Upcoming events</h1>
    <p class="text-xl text-stone-600 mb-6 max-w-3xl leading-relaxed">
      A short list of dated Temecula wine-country and community events we can verify. Hours, tickets, and street
      closures change — use the official link before you plan a tasting day around them.
    </p>
    <p class="text-stone-600 mb-12">
      For harvest pacing (not a calendar), read the
      <a class="text-[var(--accent)] underline" href="/guides/temecula-fall-wine-events-guide">fall events & grape stomps guide</a>.
    </p>

    <div class="space-y-6">
      {events.map((event) => (
        <article class="bg-white border border-stone-200 rounded-3xl p-8">
          <div class="text-sm uppercase tracking-[2px] text-[var(--accent)] font-medium">{event.date}</div>
          <h2 class="text-3xl font-serif mt-2">{event.name}</h2>
          <p class="text-stone-600 mt-1">{event.where}</p>
          <p class="text-stone-700 mt-4 leading-relaxed">{event.blurb}</p>
          <p class="mt-4 text-sm">
            <a class="text-[var(--accent)] font-medium hover:underline" href={event.url} target="_blank" rel="noopener noreferrer">
              Official info →
            </a>
            {event.facebook && (
              <span>
                <span class="mx-2 text-stone-300">·</span>
                <a class="text-[var(--accent)] hover:underline" href={event.facebook} target="_blank" rel="noopener noreferrer">
                  Facebook
                </a>
              </span>
            )}
          </p>
        </article>
      ))}
    </div>
  </main>
</Layout>
