---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import wineries from '../../data/wineries.json';

const rows = [...wineries].sort((a, b) => a.name.localeCompare(b.name));
const origin = 'https://bellieacreswine.com';
---

<Layout
  title="Link Your Temecula Winery Listing"
  description="For Temecula wineries already in the Bellie Acres Wine directory: the exact page to link, and a short note you can send your web person. Independent guide. No fee to be listed."
>
  <Navbar />
  <main class="max-w-3xl mx-auto px-6 py-12 sm:py-16">
    <p class="text-sm uppercase tracking-[2px] text-[var(--accent)] font-medium mb-3">For listed wineries</p>
    <h1 class="font-serif text-4xl sm:text-5xl tracking-tight text-stone-900 mb-5">Link your listing</h1>
    <div class="space-y-4 text-lg text-stone-700 leading-relaxed">
      <p>
        Bellie Acres Wine is an independent visitor guide. A link from your site to your own page helps guests plan a
        day and helps people find that page in search. There is no fee to be in the directory. Featured placement is a
        separate, labeled offer.
      </p>
      <p>
        Suggested link text: <strong>Plan a visit — Bellie Acres Wine</strong>. Point it at the URL beside your name
        below. Please do not link the homepage if a guest is looking for your estate.
      </p>
    </div>

    <h2 class="font-serif text-2xl text-stone-900 mt-10 mb-4">Note you can send your web person</h2>
    <pre class="whitespace-pre-wrap rounded-2xl border border-stone-200 bg-white p-5 text-sm text-stone-800 leading-relaxed">Hello,

We are listed on Bellie Acres Wine, an independent Temecula visitor guide. Would you add a link from our site to our listing?

Link text: Plan a visit — Bellie Acres Wine
URL: https://bellieacreswine.com/wineries/YOUR-SLUG/

The guide does not sell our wine and does not take reservations. Guests are told to confirm hours and fees with us.

Thank you.</pre>

    <h2 class="font-serif text-2xl text-stone-900 mt-10 mb-4">Your page</h2>
    <ul class="space-y-3">
      {rows.map((w) => (
        <li class="rounded-2xl border border-stone-200 bg-white px-4 py-3">
          <p class="font-medium text-stone-900">{w.name}</p>
          <a class="text-sm text-[var(--accent)] underline break-all" href={`/wineries/${w.slug}/`}>
            {origin}/wineries/{w.slug}/
          </a>
        </li>
      ))}
    </ul>
    <p class="text-sm text-stone-500 mt-8">
      Questions: executerceo@gmail.com. If a fact on your page is wrong, write that address and we will correct the
      listing. We do not invent hours.
    </p>
  </main>
</Layout>
