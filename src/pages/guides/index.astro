---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';

const guides = [
  {
    href: '/wineries',
    title: 'Temecula Wineries Directory & List',
    blurb: 'Full searchable list of Temecula Valley tasting rooms — the core directory for trip planning.',
    tag: 'Directory',
  },
  {
    href: '/guides/best-temecula-wineries',
    title: 'Best Temecula Wineries (2026)',
    blurb: 'Top-rated estates and how to choose the best Temecula winery for a first visit, pets, or families.',
    tag: 'Best of',
  },
  {
    href: '/guides/weekend-in-temecula-wine-country',
    title: 'Weekend in Temecula Wine Country',
    blurb: 'Friday–Sunday template: clusters, pacing, lodging logic, and linked estate picks from the directory.',
    tag: 'Itinerary',
  },
  {
    href: '/guides/temecula-red-varietals',
    title: 'Temecula Red Varietals Guide',
    blurb: 'Cabernet, Syrah, Grenache, Tempranillo, Merlot, and more — with winery examples to taste each style.',
    tag: 'Wine styles',
  },
  {
    href: '/guides/weekday-vs-weekend-tasting',
    title: 'Weekday vs Weekend Tasting',
    blurb: 'Crowds, reservations, live music, heat, and which corridors feel calmer on which days.',
    tag: 'Planning',
  },
  {
    href: '/pairings',
    title: 'Wine Pairing Suggestions',
    blurb: 'Food matches by wine type, protein, occasion, and season — with Temecula winery examples from the directory.',
    tag: 'Pairings',
  },
  {
    href: '/guides/first-timer-tasting-route',
    title: 'First-Timer Temecula Tasting Route',
    blurb: 'A realistic three-stop day on the Rancho California spine — timing, food, transport, and mistakes to skip.',
    tag: 'Planning',
  },
  {
    href: '/guides/pet-friendly-wineries',
    title: 'Pet-Friendly Wineries in Temecula',
    blurb: 'Which estates welcome dogs, what “pet friendly” really means outdoors, packing list, and no-pet resorts.',
    tag: 'Pets',
  },
  {
    href: '/guides/sip-with-a-view',
    title: 'Temecula Wineries with a View',
    blurb: 'Sip with a View — valley overlooks, hilltop decks, vineyard terraces, and lake scenery, plus directory search tips.',
    tag: 'Scenic',
  },
  {
    href: '/collection',
    title: 'The Wine Collection',
    blurb: 'Cinematic wine list — movies, TV, and documentaries that inspire wine-country living, estates, food & wine, and travel.',
    tag: 'Entertainment',
  },
];
---

<Layout
  title="Temecula Wine Guides"
  description="Temecula wine guides from Bellie Acres Wine — best wineries, weekend itineraries, red varietals, weekday vs weekend tips, pet-friendly estates, routes, and pairings."
>
  <Navbar />
  <main class="max-w-5xl mx-auto px-6 py-16">
    <h1 class="text-5xl md:text-6xl font-serif tracking-tight mb-4">Temecula Wine Guides</h1>
    <p class="text-xl text-stone-600 max-w-2xl mb-6">
      Practical long-form articles for Temecula wine country — itineraries, varietals, crowd timing, pets, views, and the full wineries directory.
    </p>
    <p class="text-stone-600 max-w-3xl mb-12 leading-relaxed">
      Start with the <a class="text-[var(--accent)] underline" href="/wineries">Temecula wineries list</a> or
      <a class="text-[var(--accent)] underline" href="/map">map</a>, then use these guides for editorial context.
      Each article links back into individual estate profiles so you can move from advice to a concrete reservation plan.
    </p>

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
      {guides.map((g) => (
        <a href={g.href} class="group block rounded-3xl border border-stone-200 bg-white p-8 hover:shadow-xl transition">
          <div class="text-xs uppercase tracking-[2px] text-[var(--accent)] font-medium mb-3">{g.tag}</div>
          <h2 class="font-serif text-3xl group-hover:text-[var(--accent)] transition">{g.title}</h2>
          <p class="text-stone-600 mt-4 leading-relaxed">{g.blurb}</p>
          <div class="mt-6 text-[var(--accent)] font-medium">Read guide →</div>
        </a>
      ))}
    </div>
  </main>
</Layout>
