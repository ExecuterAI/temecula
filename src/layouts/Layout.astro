---
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  /** Absolute or site-root image path for social cards */
  ogImage?: string;
  /** Optional JSON-LD object or array — stringified into application/ld+json */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  /** When true, use `title` as the full <title> (no brand suffix) */
  fullTitle?: boolean;
}

const {
  title,
  description = 'Temecula wine directory and wineries list — independent guide to Temecula Valley tasting rooms, maps, pairings, and trip planning at bellieacreswine.com.',
  ogImage = 'https://bellieacreswine.com/images/hero-estate-v20260728.jpg',
  jsonLd,
  fullTitle = false,
} = Astro.props;

const siteOrigin = 'https://bellieacreswine.com';
const canonical = new URL(Astro.url.pathname, siteOrigin).toString();
const pageTitle = fullTitle ? title : `${title} | Bellie Acres Wine`;
const ogImageAbs = ogImage.startsWith('http') ? ogImage : new URL(ogImage, siteOrigin).toString();
const jsonLdBlocks = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="robots" content="index,follow,max-image-preview:large" />
    <meta name="author" content="Bellie Acres Wine" />
    <meta
      name="keywords"
      content="Temecula wineries, Temecula wineries list, list of wineries in Temecula, Temecula wine map, Temecula wineries map, map of Temecula wineries, Temecula wine directory, Temecula wine, best Temecula winery, Temecula Valley wine country"
    />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#4A5E4E" />
    <meta name="google-site-verification" content="sYv-Z1JQJe3bWMDvU0VYl3KdTiMsyUoxydpbk0mceGo" />
    <title>{pageTitle}</title>

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Bellie Acres Wine" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageAbs} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageAbs} />

    {jsonLdBlocks.map((block) => (
      <script type="application/ld+json" set:html={JSON.stringify(block)} />
    ))}

    <!-- Google AdSense (Auto ads) -->
    <script
      is:inline
      async
      src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-2494978762737398"
      crossorigin="anonymous"
    ></script>
  </head>
  <body class="bg-base text-ink antialiased">
    <!-- Alcohol content notice (travel directory; 21+ tasting) -->
    <div class="bg-dark-sage text-white/90 text-xs sm:text-sm text-center px-4 py-2">
      Wine tourism directory for adults 21+. Please drink responsibly and never drink and drive.
      <a href="/privacy" class="underline ml-2 hover:text-white">Privacy</a>
      <span class="mx-1">·</span>
      <a href="/contact" class="underline hover:text-white">Contact</a>
    </div>
    <slot />
    <Footer />
  </body>
</html>

<style is:global>
  @import "tailwindcss";

  :root {
    /* Exact mockup palette (shared with lauradfarley.com) */
    --color-base-bg: #f6f7f2; /* Chantilly Lace */
    --color-primary-sage: #9aab97; /* Light Sage Accent */
    --color-dark-sage: #4a5e4e; /* Deep Sage / Buttons / Footer */
    --color-card-bg: #ffffff; /* Pure White */
    --color-text-main: #2b322c; /* Deep Charcoal */

    /* Legacy semantic tokens used across pages */
    --primary: var(--color-dark-sage);
    --accent: var(--color-primary-sage);
    --gold: var(--color-primary-sage);
  }

  /* Remap stone + amber utilities so existing pages pick up the palette */
  @theme {
    --color-base: #f6f7f2;
    --color-ink: #2b322c;
    --color-dark-sage: #4a5e4e;
    --color-sage: #9aab97;
    --color-card: #ffffff;

    --color-stone-50: #f6f7f2;
    --color-stone-100: #eef0e9;
    --color-stone-200: #dfe4db;
    --color-stone-300: #c9d2c6;
    --color-stone-400: #a3b0a1;
    --color-stone-500: #7a8779;
    --color-stone-600: #5c665e;
    --color-stone-700: #4a5e4e;
    --color-stone-800: #3a4a3d;
    --color-stone-900: #2b322c;
    --color-stone-950: #1c221e;

    --color-amber-50: #eef3ec;
    --color-amber-100: #dce4d9;
    --color-amber-200: #c5d1c2;
    --color-amber-300: #9aab97;
    --color-amber-400: #7f947c;
    --color-amber-500: #4a5e4e;
    --color-amber-600: #4a5e4e;
    --color-amber-700: #3a4a3d;
    --color-amber-800: #2b322c;
    --color-amber-900: #1c221e;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    background: var(--color-base-bg);
    color: var(--color-text-main);
  }

  /* Deep Sage primary buttons — keep hover:bg-black from looking pure black */
  a.bg-\[var\(--primary\)\]:hover,
  button.bg-\[var\(--primary\)\]:hover,
  .hover\:bg-black:hover {
    background-color: #3a4a3d !important;
  }
</style>
