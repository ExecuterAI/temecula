---
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Discover the best wineries in Temecula Valley — independent guide at bellieacreswine.com" } = Astro.props;
const canonical = new URL(Astro.url.pathname, "https://bellieacreswine.com").toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="robots" content="index,follow" />
    <meta name="google-site-verification" content="sYv-Z1JQJe3bWMDvU0VYl3KdTiMsyUoxydpbk0mceGo" />
    <title>{title} | Bellie Acres Wine</title>
    <!-- Google AdSense (Auto ads) -->
    <script
      is:inline
      async
      src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-2494978762737398"
      crossorigin="anonymous"
    ></script>
  </head>
  <body class="bg-stone-50 text-stone-900">
    <!-- Alcohol content notice (travel directory; 21+ tasting) -->
    <div class="bg-stone-900 text-stone-200 text-xs sm:text-sm text-center px-4 py-2">
      Wine tourism directory for adults 21+. Please drink responsibly and never drink and drive.
      <a href="/privacy" class="underline ml-2 hover:text-white">Privacy</a>
      <span class="mx-1">·</span>
      <a href="/contact" class="underline hover:text-white">Contact</a>
    </div>
    <slot />
    <Footer />
  </body>
</html>

<style is:global>
  @import "tailwindcss";

  :root {
    --primary: #3F2A1D;
    --accent: #8B5E3C;
    --gold: #C5A26F;
  }
</style>
